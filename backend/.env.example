# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# ============================================================================
# REDIS (Session Store & Cache)
# ============================================================================
REDIS_URL="redis://localhost:6379"
# REDIS_URL="redis://:password@localhost:6379" # Con password
# REDIS_URL="rediss://username:password@redis.cloud.com:6379" # Redis Cloud/SSL

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"          # Access token duration (15 minuti)
JWT_REFRESH_EXPIRES_IN="7d"   # Refresh token duration (7 giorni)

# JWT Claims
JWT_ISSUER="your-app-backend"           # Chi emette il token
JWT_AUDIENCE="your-app-frontend"        # Per chi è destinato il token

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Browser fingerprinting per prevenire token theft
FINGERPRINT_ENABLED="true"

# Session management
SESSION_SLIDING="true"                  # Aggiorna TTL ad ogni richiesta
MAX_CONCURRENT_SESSIONS="5"             # Max sessioni contemporanee per utente
SINGLE_REFRESH_TOKEN="false"            # Solo 1 refresh token attivo per volta

# ============================================================================
# SERVER
# ============================================================================
NODE_ENV="development"      # development | production
PORT="5000"
FRONTEND_URI="http://localhost:3000"

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL="info"            # error | warn | info | debug