{
  "name": "@mini-erp/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "prisma:migrate": "prisma migrate dev --schema=prisma && prisma generate",
    "prisma:generate": "prisma generate --schema=prisma",
    "prisma:docs": "prisma format && prisma-fmt-js",
    "build": "bun build",
    "start": "bun dist/server.js",
    "dev": "bun --watch --no-clear-screen run-server.ts",
    "dev:debug": "bun --inspect-wait --watch --no-clear-screen run-server.ts",
    "dev:break": "bun --inspect-brk --watch --no-clear-screen run-server.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@mini-erp/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "helmet": "^8.3.0",
    "hono": "^4.13.3",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "tsconfig-paths": "^4.2.0",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
