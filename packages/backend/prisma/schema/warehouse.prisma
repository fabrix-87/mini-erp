model Warehouse {
    id        Int           @id @default(autoincrement())
    name      String
    location  String?
    type      WarehouseType @default(PHYSICAL)
    createdAt DateTime      @default(now())

    stockMovements StockMovement[] // solo per magazzini fisici
    virtualStocks  VirtualStock[] // solo per magazzini virtuali
    documentLines DocumentLine[]
    stockReservations StockReservation[]
    document Document[]
}

enum WarehouseType {
    PHYSICAL // usa movimenti
    VIRTUAL // stock statico proveniente da fornitori
}

enum MovementType {
    PURCHASE // carico da fornitore
    SALE // scarico per vendita
    RETURN_IN // reso da cliente
    RETURN_OUT // reso a fornitore
    ADJUSTMENT // rettifica manuale
    TRANSFER_IN // trasferimento + (arrivo)
    TRANSFER_OUT // trasferimento - (uscita)
    INVENTORY_START // stock iniziale
}

enum MovementStatus {
    PENDING
    CONFIRMED
    CANCELLED
}

model StockMovement {
    id               Int          @id @default(autoincrement())
    productVariantId Int
    warehouseId      Int
    quantity         Int // + o -
    movementType     MovementType
    referenceId      String?
    note             String?
    movementDate     DateTime     @default(now())

    // costo movimento (per valorizzazione)
    unitCost  Decimal? @db.Decimal(20, 6)
    totalCost Decimal? @db.Decimal(20, 2)
    
    // documenti collegati
    documentId     Int?
    document       Document? @relation(fields: [documentId], references: [id])
    documentLineId Int?
    documentLine   DocumentLine? @relation(fields: [documentLineId], references: [id])

    // lotto/seriale
    batchNumber  String? @db.VarChar(50)
    serialNumber String? @db.VarChar(50)
    expiryDate   DateTime?    

    // utente che ha registrato
    createdByUserId Int?
    createdBy       User? @relation(fields: [createdByUserId], references: [id])

    // stato movimento
    status MovementStatus @default(PENDING)

    productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
    warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

    createdAt        DateTime     @default(now())

    @@index([productVariantId])
    @@index([warehouseId])
    @@index([movementDate])
    @@index([documentId])
    @@index([batchNumber])
    @@index([serialNumber])
    @@index([status])
}

enum VirtualSyncStatus {
    PENDING
    SUCCESS
    ERROR
}

model VirtualStock {
    id               Int      @id @default(autoincrement())
    productVariantId Int
    warehouseId      Int // magazzino virtuale
    quantity         Int // stock fornito dal fornitore
    updatedAt        DateTime @updatedAt
    source           String? // API name, manual, csv, ecc.

    productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
    warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

    // tracking sincronizzazione
    lastSyncAt        DateTime?
    syncStatus        VirtualSyncStatus   @default(PENDING)
    syncError         String?  @db.Text
    
    // AGGIUNGERE: disponibilità attesa
    expectedAvailableDate DateTime?
    leadTimeDays          Int      @default(0)
    
    // AGGIUNGERE: prezzo fornitore
    supplierPrice    Decimal? @db.Decimal(20, 6)
    supplierCurrency String?  @db.VarChar(3)
    
    @@index([syncStatus, lastSyncAt])
    @@unique([productVariantId, warehouseId]) // Uno stock virtuale per variante per magazzino
}

// gestione lotti
model StockBatch {
    id               Int      @id @default(autoincrement())
    productVariantId Int
    productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
    
    batchNumber      String   @db.VarChar(50)
    manufacturedDate DateTime?
    expiryDate       DateTime?
    
    supplierId       Int?
    supplier         Supplier? @relation(fields: [supplierId], references: [id])
    
    quantity         Int      @default(0)
    reserved         Int      @default(0)
    
    status           String   @default("active") @db.VarChar(20) // "active", "quarantine", "expired"
    
    @@unique([productVariantId, batchNumber])
    @@index([expiryDate])
}

// AGGIUNGERE: gestione prenotazioni
model StockReservation {
    id               Int      @id @default(autoincrement())
    productVariantId Int
    productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
    
    warehouseId      Int
    warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
    
    quantity         Int
    
    // Riferimento al documento che ha prenotato
    documentId       Int
    document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
    documentLineId   Int?
    documentLine     DocumentLine? @relation(fields: [documentLineId], references: [id])
    
    status           String   @default("active") @db.VarChar(20) // "active", "fulfilled", "cancelled", "expired"
    
    reservedAt       DateTime @default(now())
    expiresAt        DateTime? // Prenotazione temporanea (carrello)
    fulfilledAt      DateTime?
    cancelledAt      DateTime?
    
    batchNumber      String?  @db.VarChar(50) // Lotto specifico prenotato
    
    @@index([productVariantId, warehouseId, status])
    @@index([documentId])
    @@index([expiresAt])
}
