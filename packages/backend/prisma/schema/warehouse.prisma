// ============================================================================
// WAREHOUSE
// Physical warehouses use stock movements.
// Virtual warehouses expose supplier-provided stock snapshots.
// ============================================================================

/// Inventory location used for physical or virtual stock.
model Warehouse {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantWarehouses", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    /// Business identifier used on DDT, imports and integrations (e.g. "MAIN").
    code String @db.VarChar(20)

    /// Human-readable warehouse name.
    name String

    /// Optional physical or business location label.
    location String?

    /// Warehouse operating mode.
    type WarehouseType @default(PHYSICAL)

    /// Supplier feeding this warehouse. Only meaningful for VIRTUAL warehouses.
    supplierId String?   @map("supplier_id")
    supplier   Supplier? @relation("SupplierWarehouse", fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    /// Inactive warehouses reject new movements/reservations; history is preserved.
    active    Boolean @default(true)
    /// Pre-filled on new documents. At most one per tenant.
    isDefault Boolean @default(false) @map("is_default")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    stockMovements    StockMovement[]
    virtualStocks     VirtualStock[]
    stockReservations StockReservation[]
    stockBatches      StockBatch[]

    /// Documents associated with this warehouse.
    documents Document[]

    /// Document lines associated with this warehouse.
    documentLines DocumentLine[]

    @@unique([tenantId, id])
    @@unique([tenantId, code])
    @@unique([tenantId], where: { isDefault: true }, map: "unique_default_warehouse_per_tenant")
    @@index([tenantId, type])
    @@index([tenantId, supplierId], where: { supplierId: { not: null } })
    @@map("warehouses")
}

enum WarehouseType {
    /// Uses movement-based stock accounting.
    PHYSICAL

    /// Uses externally provided static availability.
    VIRTUAL
}

enum MovementType {
    PURCHASE
    SALE
    RETURN_IN
    RETURN_OUT
    ADJUSTMENT_IN
    ADJUSTMENT_OUT
    TRANSFER_IN
    TRANSFER_OUT
    INVENTORY_START
}

enum MovementStatus {
    PENDING
    CONFIRMED
    CANCELLED
}

enum VirtualSyncStatus {
    PENDING
    SUCCESS
    ERROR
}

enum StockBatchStatus {
    ACTIVE
    QUARANTINE
    EXPIRED
}

enum StockReservationStatus {
    ACTIVE
    FULFILLED
    CANCELLED
    EXPIRED
}

/// Immutable stock ledger movement for a product variant in a physical warehouse.
model StockMovement {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")

    tenant Tenant @relation("TenantStockMovements", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    /// Absolute movement quantity. Direction is determined by movement type.
    quantity Decimal

    movementType MovementType @map("movement_type")

    /// Optional business or external reference identifier.
    referenceId String? @map("reference_id")

    note String?

    /// Business-effective movement timestamp.
    movementDate DateTime @default(now()) @map("movement_date")

    /// Unit cost used for stock valuation when applicable.
    unitCost Decimal? @map("unit_cost") @db.Decimal(20, 6)

    /// Total cost for the movement.
    totalCost Decimal? @map("total_cost") @db.Decimal(20, 6)

    /// Optional batch identifier for lot-tracked inventory.
    batchNumber String? @map("batch_number") @db.VarChar(50)

    /// Optional serial identifier for uniquely tracked items.
    serialNumber String? @map("serial_number") @db.VarChar(50)

    expiryDate DateTime? @map("expiry_date")

    createdByUserId String? @map("created_by_user_id")
    createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

    status MovementStatus @default(PENDING)

    warehouseId String    @map("warehouse_id")
    warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    createdAt DateTime @default(now()) @map("created_at")

    documentId String?   @map("document_id")
    document   Document? @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    documentLineId String?       @map("document_line_id")
    documentLine   DocumentLine? @relation(fields: [tenantId, documentLineId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    productVariantId String         @map("product_variant_id")
    productVariant   ProductVariant @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    @@index([tenantId, warehouseId, productVariantId, movementDate])
    @@index([tenantId, productVariantId, movementDate])
    @@index([tenantId, movementDate])
    @@index([tenantId, documentId], where: { documentId: { not: null } })
    @@index([tenantId, documentLineId], where: { documentLineId: { not: null } })
    @@index([tenantId, batchNumber], where: { batchNumber: { not: null } })
    @@index([tenantId, serialNumber], where: { serialNumber: { not: null } })
    @@map("stock_movements")
}

/// Supplier-provided stock snapshot for a product variant in a virtual warehouse.
model VirtualStock {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")

    tenant Tenant @relation("TenantVirtualStocks", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    warehouseId String @map("warehouse_id")

    warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    productVariantId String @map("product_variant_id")

    productVariant ProductVariant @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    quantity Decimal

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    source String? @db.VarChar(100)

    lastSyncAt DateTime?         @map("last_sync_at")
    syncStatus VirtualSyncStatus @default(PENDING) @map("sync_status")
    syncError  String?           @map("sync_error") @db.Text

    expectedAvailableDate DateTime? @map("expected_available_date")
    leadTimeDays          Int       @default(0) @map("lead_time_days")

    supplierPrice Decimal? @map("supplier_price") @db.Decimal(20, 6)

    supplierCurrencyCode String?   @map("supplier_currency_code") @db.Char(3)
    supplierCurrency     Currency? @relation("VirtualStockCurrency", fields: [supplierCurrencyCode], references: [code], onDelete: SetNull, onUpdate: Cascade)

    @@unique([tenantId, productVariantId, warehouseId])
    @@index([tenantId, syncStatus, lastSyncAt])
    @@map("virtual_stocks")
}

// ============================================================================
// LOT TRACKING
// ============================================================================

/// Batch tracked for a product variant within a warehouse.
model StockBatch {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")

    tenant Tenant @relation("TenantStockBatches", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    productVariantId String         @map("product_variant_id")
    productVariant   ProductVariant @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    warehouseId String    @map("warehouse_id")
    warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    /// Batch identifier unique within the same product variant and warehouse.
    batchNumber String @map("batch_number") @db.VarChar(50)

    manufacturedDate DateTime? @map("manufactured_date")
    expiryDate       DateTime? @map("expiry_date")

    /// Current on-hand quantity for the batch.
    quantity Decimal @default(0)

    /// Reserved quantity not currently available for allocation.
    reserved Decimal @default(0)

    status StockBatchStatus @default(ACTIVE)

    supplierId String?   @map("supplier_id")
    supplier   Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([tenantId, productVariantId, warehouseId, batchNumber])
    @@index([tenantId, supplierId], where: { supplierId: { not: null } })
    @@index([tenantId, expiryDate])
    @@index([tenantId, warehouseId, productVariantId])
    @@map("stock_batches")
}

/// Reserved quantity for a product variant in a warehouse.
model StockReservation {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")

    tenant Tenant @relation("TenantStockReservations", fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    productVariantId String         @map("product_variant_id")
    productVariant   ProductVariant @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    warehouseId String    @map("warehouse_id")
    warehouse   Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    /// Reserved quantity blocked from general availability.
    quantity Decimal

    documentId String   @map("document_id")
    document   Document @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    documentLineId String?       @map("document_line_id")
    documentLine   DocumentLine? @relation(fields: [tenantId, documentLineId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    status StockReservationStatus @default(ACTIVE)

    reservedAt DateTime @default(now()) @map("reserved_at")

    /// Optional expiry for temporary reservations.
    expiresAt DateTime? @map("expires_at")

    fulfilledAt DateTime? @map("fulfilled_at")
    cancelledAt DateTime? @map("cancelled_at")

    /// Optional batch-specific reservation.
    batchNumber String? @map("batch_number") @db.VarChar(50)

    @@index([tenantId, productVariantId, warehouseId, status])
    @@index([tenantId, documentId])
    @@index([tenantId, documentLineId])
    @@index([tenantId, expiresAt], where: { expiresAt: { not: null }, status: "ACTIVE" })
    @@index([tenantId, warehouseId, status, expiresAt])
    @@map("stock_reservations")
}
