// ============================================================================
// ANAGRAFICA CLIENTI
// ============================================================================

// Enum per il tipo di azienda
enum CustomerType {
    PROSPECT // Cliente potenziale (già qualificato, non ancora acquistato)
    CUSTOMER // Cliente attivo
    PARTNER // Partner commerciale
    OTHER // Altro
}

// Enum per lo stato di Credit Check
enum CreditCheckStatus {
    PENDING
    APPROVED
    REJECTED
    IN_PROGRESS
}

// Enum per la dimensione del cliente
enum CustomerSize {
    MICRO
    SMALL
    MEDIUM
    LARGE
    ENTERPRISE
}

// Enum per la priorità del cliente
enum CustomerPriority {
    LOW
    MEDIUM
    HIGH
}

// Enum per il segmento del cliente
enum CustomerSegment {
    VIP
    GOLD
    SILVER
    BRONZE
    STANDARD
}

// Enum per il tipo di entità aziendale
enum CompanyTypeEntity {
    JURIDICAL // Persona Giuridica (Azienda)
    NATURAL // Persona Fisica (Privato/Ditta individuale)
    FOREIGN // Entità Estera
}

// Enum per stato azienda
enum CompanyStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

// Tabella Company (base comune)
model Company {
    id String @id @default(cuid())

    // Dati Base
    code        String  @unique @db.VarChar(20)
    companyName String  @map("company_name") @db.VarChar(255)
    tradeName   String? @map("trade_name") @db.VarChar(255)
    legalForm   String? @map("legal_form") @db.VarChar(100)

    status CompanyStatus @default(ACTIVE)

    // Tipo Persona (per differenziare l'uso di CF o P.IVA)
    entityType CompanyTypeEntity @default(JURIDICAL) @map("entity_type")

    // Dati Fiscali ITALIANI (SdI)
    vatNumber String? @map("vat_number") @db.VarChar(20) // Partita IVA 
    taxCode   String? @map("tax_code") @db.VarChar(20) // Codice Fiscale

    // Codice Destinatario (o SDI/PEC)
    sdiCode String? @map("sdi_code") @db.VarChar(7) // Codice SDI (7 caratteri, '0000000' per i privati/esteri)
    pec     String? @db.VarChar(255) // Indirizzo PEC

    // Dati Fiscali ESTERI (necessari se Country non è IT)
    eoriNumber String? @map("eori_number") @db.VarChar(20) // EORI (per transazioni extra UE)
    vatId      String? @map("vat_id") @db.VarChar(20) // VAT ID per UE (es. FR123456789)

    // Nazione Fiscale
    countryCode String  @default("IT") @map("country_code") @db.Char(2) // Codice ISO 31
    country     Country @relation("CompanyCountry", fields: [countryCode], references: [code])

    // Contatti Generali
    mainEmail String? @map("main_email") @db.VarChar(255) // Email principale del contatto
    mainPhone String? @map("main_phone") @db.VarChar(50)

    // Relazioni
    user           User?      @relation("AssignedUser", fields: [assignedUserId], references: [id])
    assignedUserId String?    @map("assigned_user_id")
    activities     Activity[] @relation("CompanyActivities")

    // Tenant opzionale (per creazione company del nuovo tenant stesso)
    tenantId String? @map("tenant_id")
    tenant   Tenant? @relation("TenantCompanies", fields: [tenantId], references: [id], onDelete: SetNull)

    // Indirizzi
    addresses CompanyAddress[] @relation("CompanyAddresses")

    // Contatti e Relazioni Commerciali
    contacts  CompanyContact[]
    customers Customer[]
    suppliers Supplier[]
    tenants   Tenant?          @relation("TenantOwnedCompany")

    // Note
    notes CompanyNote[]

    // Custom Fields
    customFields Json? @map("custom_fields")

    // Campi per tracking
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    // Index
    @@index([vatNumber])
    @@index([taxCode])
    @@map("companies")
}

// Tabella Customer
model Customer {
    id String @id @default(cuid())

    // Collegamento 1-a-1 alla Company
    companyId String  @unique @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    // Dati specifici Cliente/CRM
    priority     CustomerPriority  @default(LOW)
    segment      CustomerSegment   @default(STANDARD)
    size         CustomerSize      @default(SMALL)
    type         CustomerType      @default(PROSPECT)
    creditStatus CreditCheckStatus @default(PENDING)

    // Dati Commerciali
    defaultPriceListId Int?       @map("default_price_list_id")
    defaultPriceList   PriceList? @relation(fields: [defaultPriceListId], references: [id], onDelete: SetNull)

    customerTaxRuleId Int?     @map("customer_tax_rule_id")
    customerTaxRule   TaxRule? @relation("CustomerTaxRule", fields: [customerTaxRuleId], references: [id])

    paymentMethodId Int?           @map("payment_method_id")
    paymentMethod   PaymentMethod? @relation("CompanyPaymentMethod", fields: [paymentMethodId], references: [id])

    creditLimit Decimal? @map("credit_limit") @db.Decimal(15, 2) // Limite di credito CONCESSO al Cliente

    // Tracking/Reportistica
    firstSaleDate DateTime? @map("first_sale_date") // Prima vendita CONFERMATA
    lastSaleDate  DateTime? @map("last_sale_date") // Ultima vendita CONFERMATA
    totalSales    Int       @default(0) @map("total_sales") // Numero ordini TOTALI
    totalRevenue  Decimal   @default(0) @map("total_revenue") @db.Decimal(15, 2) // Fatturato TOTALE reale

    // Date estese
    customerSince     DateTime? @map("customer_since") // Data entrata in CRM (può essere prima di firstSaleDate)
    lastInteractionAt DateTime? @map("last_interaction_at") // Ultima attività (vendita, email, call, meeting)

    // Metriche calcolate
    averageOrderValue Decimal @default(0) @map("average_order_value") @db.Decimal(15, 2) // Fatturato medio ( totalRevenue / totalSales )
    lifetimeValue     Decimal @default(0) @map("lifetime_value") @db.Decimal(15, 2) // LTV (storico + proiezione)

    // Score predittivi
    churnRisk   Int @default(0) @map("churn_risk") @db.SmallInt // 0-100 (rischio abbandono)
    healthScore Int @default(50) @map("health_score") @db.SmallInt // 0-100 (salute complessiva)

    // NPS e soddisfazione
    npsScore         Int?      @map("nps_score") @db.SmallInt // -100 a +100
    satisfactionRate Decimal?  @map("satisfaction_rate") @db.Decimal(3, 2) // 0.00 - 5.00
    lastSurveyDate   DateTime? @map("last_survey_date") // Data dell'ultimo sondaggio

    // Relazioni a documenti di Vendita
    documentsOut  Document[]    @relation("CustomerDocuments")
    opportunities Opportunity[]
    activities    Activity[]    @relation("CustomerActivities")

    // Relazioni tra clienti (gruppi e gerarchie)
    parentCustomerId String?    @map("parent_customer_id")
    parentCustomer   Customer?  @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id], onDelete: SetNull)
    subsidiaries     Customer[] @relation("CustomerHierarchy")

    // Lead convertita in questo customer
    convertedFromLead Lead? @relation("ConvertedCustomer")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    // Safe delete
    deletedBy     String? @map("deleted_by")
    deletedByUser User?   @relation("DeletedBy", fields: [deletedBy], references: [id])

    @@index([parentCustomerId])
    @@index([deletedAt])
    @@map("customers")
}

// Tabella Supplier
model Supplier {
    id String @id @default(cuid())

    // Collegamento 1-a-1 alla Company
    companyId String  @unique @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    // Dati specifici Fornitore
    paymentTerms String?  @map("payment_terms") @db.VarChar(100) // Es. 30 giorni data fattura fine mese
    creditLimit  Decimal? @map("credit_limit") @db.Decimal(15, 2) // Limite di credito CONCESSO dal Fornitore
    bankAccount  String?  @map("bank_account") @db.VarChar(100) // IBAN per bonifici in USCITA

    // Costi e Logistica
    leadTimeDays  Int?     @default(0) @map("lead_time_days") // Tempo standard di consegna
    transportCost Decimal? @map("transport_cost") @db.Decimal(10, 2) // Costo standard di trasporto

    // Tracking/Reportistica
    firstOrderDate DateTime? @map("first_order_date") // Data del primo ordine
    lastOrderDate  DateTime? @map("last_order_date") // Data dell'ultimo ordine
    totalOrders    Int       @default(0) @map("total_orders")
    totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(15, 2)
    rating         Int?      @default(5) // 1-5 stelle 

    supplierTaxRuleId Int?     @map("supplier_tax_rule_id")
    supplierTaxRule   TaxRule? @relation("SupplierTaxRule", fields: [supplierTaxRuleId], references: [id])

    // Relazioni a documenti di Acquisto
    documentsIn Document[] @relation("SupplierDocuments")
    products    Product[]

    // Relazione stocks
    stockBatchs StockBatch[]

    // Relazioni tra fornitori (gruppi e gerarchie)
    parentSupplierId String?    @map("parent_supplier_id")
    parentSupplier   Supplier?  @relation("SupplierHierarchy", fields: [parentSupplierId], references: [id], onDelete: SetNull)
    subsidiaries     Supplier[] @relation("SupplierHierarchy")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    deletedBy     String? @map("deleted_by")
    deletedByUser User?   @relation("DeletedBy", fields: [deletedBy], references: [id])

    @@index([parentSupplierId])
    @@index([deletedAt])
    @@map("suppliers")
}

// Enum per tipo indirizzo
enum AddressType {
    LEGAL
    BILLING
    SHIPPING
    OFFICE
    WAREHOUSE
    OTHER
}

// Modello per gli indirizzi delle aziende
model CompanyAddress {
    id        Int     @id @default(autoincrement()) @map("id")
    companyId String  @map("company_id")
    company   Company @relation("CompanyAddresses", fields: [companyId], references: [id], onDelete: Cascade)

    addressType AddressType @default(BILLING) @map("address_type")
    isPrimary   Boolean     @default(false) @map("is_primary")

    address      String  @db.VarChar(255)
    city         String  @db.VarChar(100)
    provinceCode String? @map("province_code") @db.Char(2)
    zipCode      String  @map("zip_code") @db.VarChar(20)

    countryCode String  @default("IT") @map("country_code") @db.Char(2)
    country     Country @relation("AddressCountry", fields: [countryCode], references: [code])

    latitude  Decimal? @db.Decimal(10, 8)
    longitude Decimal? @db.Decimal(11, 8)

    phone        String? @db.VarChar(50)
    openingHours Json?   @map("opening_hours")
    notes        String? @db.Text

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    // Partial unique: only one LEGAL address per company
    @@unique([companyId], map: "unique_company_legal_address", where: raw("address_type = 'LEGAL'"))
    @@index([companyId])
    @@index([companyId, addressType])
    @@map("company_addresses")
}

// Modello per i contatti
model Contact {
    id String @id @default(cuid())

    // Dati anagrafici puri — nessun companyId diretto
    firstName   String  @map("first_name") @db.VarChar(100)
    lastName    String? @map("last_name") @db.VarChar(100)
    email       String? @unique @db.VarChar(255) // unique globale, non per company
    phone       String? @db.VarChar(50)
    mobilePhone String? @map("mobile_phone") @db.VarChar(50)

    active Boolean @default(true)
    notes  String? @db.Text

    // Relazioni
    companies            CompanyContact[]
    documents            Document[]
    activities           Activity[]            @relation("ContactActivities")
    activityParticipants ActivityParticipant[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([email])
    @@map("contacts")
}

// Tabella di relazione many-to-many con dati contestuali
model CompanyContact {
    id        Int     @id @default(autoincrement()) @map("id")
    contactId String  @map("contact_id")
    contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    position         String? @db.VarChar(100)
    department       String? @db.VarChar(100)
    isPrimaryContact Boolean @default(false) @map("is_primary_contact")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([companyId, contactId])
    // Partial unique: only one primary contact per company
    @@unique([companyId], map: "unique_primary_contact_per_company", where: { isPrimaryContact: true })
    @@index([contactId])
    @@index([companyId])
    @@map("company_contacts")
}

// Tabella Note
model CompanyNote {
    id        Int      @id @default(autoincrement())
    companyId String   @map("company_id")
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    title     String   @db.VarChar(255)
    content   String   @db.Text
    authorId  String?  @map("author_id")
    author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([companyId])
    @@index([authorId])
    @@map("company_notes")
}
