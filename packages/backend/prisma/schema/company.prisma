// ============================================================================
// COMPANY / CUSTOMER / SUPPLIER
// ============================================================================

enum CustomerType {
    PROSPECT // Not yet a paying customer; qualified lead
    CUSTOMER // Active paying customer
    PARTNER // Commercial partner
    OTHER
}

enum CreditCheckStatus {
    PENDING
    IN_PROGRESS
    APPROVED
    REJECTED
}

enum CustomerSize {
    MICRO
    SMALL
    MEDIUM
    LARGE
    ENTERPRISE
}

enum CustomerPriority {
    LOW
    MEDIUM
    HIGH
}

enum CustomerSegment {
    VIP
    GOLD
    SILVER
    BRONZE
    STANDARD
}

/// Distinguishes legal entity type, driving which fiscal identifiers are required.
enum CompanyTypeEntity {
    JURIDICAL // Persona giuridica — P.IVA required
    NATURAL // Persona fisica / ditta individuale — CF required
    FOREIGN // Foreign entity — vatId / EORI
}

enum CompanyStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

/// Base registry shared by Customer, Supplier, and the tenant's own company.
/// Always owned by a tenant except during bootstrap (see tenantId comment).
model Company {
    id String @id @default(cuid())

    // === IDENTITY ===

    code        String            @db.VarChar(20)
    companyName String            @map("company_name") @db.VarChar(255)
    tradeName   String?           @map("trade_name") @db.VarChar(255)
    legalForm   String?           @map("legal_form") @db.VarChar(100)
    status      CompanyStatus     @default(ACTIVE)
    entityType  CompanyTypeEntity @default(JURIDICAL) @map("entity_type")

    // === ITALIAN FISCAL DATA ===

    vatNumber String? @map("vat_number") @db.VarChar(20)
    taxCode   String? @map("tax_code") @db.VarChar(20)
    /// SDI recipient code for FatturaPA routing. '0000000' for private/foreign.
    sdiCode   String? @map("sdi_code") @db.VarChar(7)
    pec       String? @db.VarChar(255)

    // === FOREIGN FISCAL DATA ===

    /// EORI number — required for extra-EU customs transactions.
    eoriNumber String? @map("eori_number") @db.VarChar(20)
    /// EU VAT identifier (e.g. FR123456789). Populated when countryCode ≠ IT.
    vatId      String? @map("vat_id") @db.VarChar(20)

    // === FISCAL COUNTRY ===

    /// ISO 3166-1 alpha-2. Drives fiscal regime and Intrastat flow detection.
    countryCode String  @default("IT") @map("country_code") @db.Char(2)
    country     Country @relation("CompanyCountry", fields: [countryCode], references: [code])

    // === CONTACTS ===

    mainEmail String? @map("main_email") @db.VarChar(255)
    mainPhone String? @map("main_phone") @db.VarChar(50)

    // === OWNERSHIP ===

    assignedUserId String? @map("assigned_user_id")
    user           User?   @relation("AssignedUser", fields: [assignedUserId], references: [id])

    /// Nullable for two reasons only:
    /// (1) Bootstrap window: the tenant's own Company is created before the Tenant row
    ///     (Tenant.companyId is mandatory). tenantId is back-filled in the same transaction:
    ///     CREATE Company → CREATE Tenant → UPDATE Company SET tenantId.
    /// (2) Orphaning: if a Tenant is deleted (onDelete: SetNull), its Companies are
    ///     preserved for historical traceability with tenantId = NULL.
    /// All live Company records linked to an active Customer/Supplier always have tenantId set.
    tenantId String? @map("tenant_id")
    tenant   Tenant? @relation("TenantCompanies", fields: [tenantId], references: [id], onDelete: SetNull)

    // === RELATIONS ===

    addresses    CompanyAddress[] @relation("CompanyAddresses")
    contacts     CompanyContact[]
    customer     Customer?
    supplier     Supplier?
    tenants      Tenant?          @relation("TenantOwnedCompany")
    notes        CompanyNote[]
    bankAccounts BankAccount[]    @relation("CompanyBankAccounts")
    activities   Activity[]       @relation("CompanyActivities")

    customFields Json? @map("custom_fields")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([tenantId, code])
    @@index([tenantId, vatNumber])
    @@index([tenantId, taxCode])
    @@map("companies")
}

/// CRM and commercial profile of a customer, extending Company 1-to-1.
model Customer {
    id String @id @default(cuid())

    companyId String  @unique @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    /// Denormalized from Company for direct tenant-scoped queries without join.
    /// Must match Company.tenantId — enforced at application level on creation.
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantCustomers", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    // === CRM CLASSIFICATION ===

    type         CustomerType      @default(PROSPECT)
    priority     CustomerPriority  @default(LOW)
    segment      CustomerSegment   @default(STANDARD)
    size         CustomerSize      @default(SMALL)
    creditStatus CreditCheckStatus @default(PENDING)

    // === COMMERCIAL DEFAULTS ===

    defaultPriceListId String?    @map("default_price_list_id")
    defaultPriceList   PriceList? @relation(fields: [defaultPriceListId], references: [id], onDelete: SetNull)

    customerTaxRuleId Int?     @map("customer_tax_rule_id")
    customerTaxRule   TaxRule? @relation("CustomerTaxRule", fields: [customerTaxRuleId], references: [id])

    paymentMethodId String?        @map("payment_method_id")
    paymentMethod   PaymentMethod? @relation("CompanyPaymentMethod", fields: [paymentMethodId], references: [id])

    creditLimit Decimal? @map("credit_limit") @db.Decimal(15, 2)

    // === SALES TRACKING (denormalized, updated on payment events) ===

    firstSaleDate DateTime? @map("first_sale_date")
    lastSaleDate  DateTime? @map("last_sale_date")
    totalSales    Int       @default(0) @map("total_sales")
    totalRevenue  Decimal   @default(0) @map("total_revenue") @db.Decimal(15, 2)

    /// Date of first CRM entry — may precede firstSaleDate.
    customerSince     DateTime? @map("customer_since")
    /// Timestamp of the last recorded interaction (sale, email, call, meeting).
    lastInteractionAt DateTime? @map("last_interaction_at")

    // === COMPUTED METRICS (updated by background job) ===

    /// totalRevenue / totalSales. Zero when totalSales = 0.
    averageOrderValue Decimal @default(0) @map("average_order_value") @db.Decimal(15, 2)
    /// Lifetime value — historical spend plus projection.
    lifetimeValue     Decimal @default(0) @map("lifetime_value") @db.Decimal(15, 2)

    // === PREDICTIVE SCORES ===

    /// Churn risk score 0–100 (higher = more likely to churn). Updated by ML job.
    churnRisk   Int @default(0) @map("churn_risk") @db.SmallInt
    /// Overall health score 0–100. Composite of recency, frequency, spend.
    healthScore Int @default(50) @map("health_score") @db.SmallInt

    // === SATISFACTION ===

    /// Net Promoter Score -100 to +100.
    npsScore         Int?      @map("nps_score") @db.SmallInt
    /// Average satisfaction rating 0.00–5.00.
    satisfactionRate Decimal?  @map("satisfaction_rate") @db.Decimal(3, 2)
    lastSurveyDate   DateTime? @map("last_survey_date")

    // === HIERARCHY ===

    parentCustomerId String?    @map("parent_customer_id")
    parentCustomer   Customer?  @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id], onDelete: SetNull)
    subsidiaries     Customer[] @relation("CustomerHierarchy")

    // === RELATIONS ===

    documentsOut      Document[]    @relation("CustomerDocuments")
    opportunities     Opportunity[]
    activities        Activity[]    @relation("CustomerActivities")
    convertedFromLead Lead?         @relation("ConvertedCustomer")

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    deletedBy     String? @map("deleted_by")
    deletedByUser User?   @relation("DeletedBy", fields: [deletedBy], references: [id])

    @@unique([tenantId, companyId])
    @@index([tenantId, type])
    @@index([tenantId, segment])
    @@index([tenantId, creditStatus])
    @@index([tenantId, deletedAt])
    @@index([parentCustomerId])
    @@index([deletedAt])
    @@map("customers")
}

/// Procurement and fiscal profile of a supplier, extending Company 1-to-1.
model Supplier {
    id String @id @default(cuid())

    companyId String  @unique @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    /// Denormalized from Company for direct tenant-scoped queries without join.
    /// Must match Company.tenantId — enforced at application level on creation.
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantSuppliers", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    // === FISCAL ===

    /// FatturaPA fiscal regime code (RF01–RF19).
    /// Validated at application level against the FatturaPA code list — no FK needed (stable list).
    fiscalRegimeCode String? @map("fiscal_regime_code") @db.VarChar(4)

    /// True if this supplier is subject to withholding tax (ritenuta d'acconto).
    isWithholdingSubject        Boolean             @default(false) @map("is_withholding_subject")
    /// Default withholding tax type applied to INBOUND invoices from this supplier.
    /// Drives pre-population of Document.withholdingTaxTypeId at invoice creation.
    defaultWithholdingTaxTypeId String?             @map("default_withholding_tax_type_id")
    defaultWithholdingTaxType   WithholdingTaxType? @relation("SupplierDefaultWithholdingTaxType", fields: [defaultWithholdingTaxTypeId], references: [id], onDelete: SetNull)

    /// Override rate if this supplier has a negotiated percentage different from WithholdingTaxType.rate.
    /// NULL means use the standard rate from the related WithholdingTaxType.
    defaultWithholdingPercent Decimal? @map("default_withholding_percent") @db.Decimal(5, 2)

    /// FatturaPA social security fund code (TC01–TC22, e.g. TC02 = INPS, TC07 = ENPAM).
    socialSecurityFundId String?             @map("social_security_fund_id")
    socialSecurityFund   SocialSecurityFund? @relation(fields: [socialSecurityFundId], references: [id], onDelete: SetNull)

    /// Override rate if this supplier has a negotiated percentage different from SocialSecurityFund.defaultRate.
    /// NULL means use the standard rate from the related SocialSecurityFund.
    defaultContributionPercent Decimal? @map("default_contribution_percent") @db.Decimal(5, 2)

    // === COMMERCIAL DEFAULTS ===

    paymentMethodId String?        @map("payment_method_id")
    paymentMethod   PaymentMethod? @relation("SupplierPaymentMethod", fields: [paymentMethodId], references: [id])

    supplierTaxRuleId Int?     @map("supplier_tax_rule_id")
    supplierTaxRule   TaxRule? @relation("SupplierTaxRule", fields: [supplierTaxRuleId], references: [id])

    /// Credit limit granted by this supplier to the tenant.
    creditLimit Decimal? @map("credit_limit") @db.Decimal(15, 2)

    // === LOGISTICS ===

    leadTimeDays  Int?     @default(0) @map("lead_time_days")
    transportCost Decimal? @map("transport_cost") @db.Decimal(10, 2)

    // === PURCHASE TRACKING (denormalized, updated on order/invoice events) ===

    firstOrderDate DateTime? @map("first_order_date")
    lastOrderDate  DateTime? @map("last_order_date")
    totalOrders    Int       @default(0) @map("total_orders")
    totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(15, 2)
    /// Supplier quality rating 1–5.
    rating         Int?      @default(5)

    // === HIERARCHY ===

    parentSupplierId String?    @map("parent_supplier_id")
    parentSupplier   Supplier?  @relation("SupplierHierarchy", fields: [parentSupplierId], references: [id], onDelete: SetNull)
    subsidiaries     Supplier[] @relation("SupplierHierarchy")

    // === RELATIONS ===

    documentsIn                Document[]                     @relation("SupplierDocuments")
    withholdingSettlementLines WithholdingTaxSettlementLine[] @relation("SupplierWithholdingLines")
    products                   Product[]
    stockBatchs                StockBatch[]

    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    deletedBy     String? @map("deleted_by")
    deletedByUser User?   @relation("DeletedBy", fields: [deletedBy], references: [id])

    @@unique([tenantId, companyId])
    @@index([tenantId, deletedAt])
    @@index([parentSupplierId])
    @@index([deletedAt])
    @@map("suppliers")
}

enum AddressType {
    LEGAL
    BILLING
    SHIPPING
    OFFICE
    WAREHOUSE
    OTHER
}

model CompanyAddress {
    id        String  @id @default(cuid())
    companyId String  @map("company_id")
    company   Company @relation("CompanyAddresses", fields: [companyId], references: [id], onDelete: Cascade)

    addressType AddressType @default(BILLING) @map("address_type")
    isPrimary   Boolean     @default(false) @map("is_primary")

    address      String  @db.VarChar(255)
    city         String  @db.VarChar(100)
    provinceCode String? @map("province_code") @db.Char(2)
    zipCode      String  @map("zip_code") @db.VarChar(20)

    countryCode String  @default("IT") @map("country_code") @db.Char(2)
    country     Country @relation("AddressCountry", fields: [countryCode], references: [code])

    latitude  Decimal? @db.Decimal(10, 8)
    longitude Decimal? @db.Decimal(11, 8)

    phone        String? @db.VarChar(50)
    openingHours Json?   @map("opening_hours")
    notes        String? @db.Text

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    /// Enforces at most one LEGAL address per company.
    @@unique([companyId], map: "unique_company_legal_address", where: raw("address_type = 'LEGAL'"))
    @@index([companyId])
    @@index([companyId, addressType])
    @@map("company_addresses")
}

/// Person contact, independent of any single company.
/// Associated to one or more companies via CompanyContact.
model Contact {
    id String @id @default(cuid())

    firstName   String  @map("first_name") @db.VarChar(100)
    lastName    String? @map("last_name") @db.VarChar(100)
    email       String? @db.VarChar(255)
    phone       String? @db.VarChar(50)
    mobilePhone String? @map("mobile_phone") @db.VarChar(50)
    active      Boolean @default(true)
    notes       String? @db.Text

    tenantId             String                @map("tenant_id")
    tenant               Tenant                @relation("TenantContacts", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    companies            CompanyContact[]
    documents            Document[]
    activities           Activity[]            @relation("ContactActivities")
    activityParticipants ActivityParticipant[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    /// Email unique per tenant. Partial: allows multiple NULL emails within the same tenant.
    @@unique([tenantId, email], where: { email: { not: null } }, map: "unique_tenant_contact_email")
    @@index([tenantId])
    @@index([tenantId, active])
    @@map("contacts")
}

/// Many-to-many join between Contact and Company with role metadata.
model CompanyContact {
    id        Int     @id @default(autoincrement())
    contactId String  @map("contact_id")
    contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
    companyId String  @map("company_id")
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    position         String? @db.VarChar(100)
    department       String? @db.VarChar(100)
    isPrimaryContact Boolean @default(false) @map("is_primary_contact")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([companyId, contactId])
    /// Enforces at most one primary contact per company.
    @@unique([companyId], map: "unique_primary_contact_per_company", where: { isPrimaryContact: true })
    @@index([contactId])
    @@index([companyId])
    @@map("company_contacts")
}

/// Internal note attached to a company. Append-friendly; not soft-deleted.
model CompanyNote {
    id        Int      @id @default(autoincrement())
    companyId String   @map("company_id")
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    title     String   @db.VarChar(255)
    content   String   @db.Text
    authorId  String?  @map("author_id")
    author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@index([companyId])
    @@index([authorId])
    @@map("company_notes")
}
