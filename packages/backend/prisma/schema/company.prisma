// ============================================================================
// ANAGRAFICA CLIENTI
// ============================================================================

// Enum per il tipo di azienda
enum CustomerType {
    PROSPECT // Cliente potenziale (già qualificato, non ancora acquistato)
    CUSTOMER // Cliente attivo
    PARTNER // Partner commerciale
    OTHER // Altro
}

// Enum per lo stato di Credit Check
enum CreditCheckStatus {
    PENDING
    APPROVED
    REJECTED
    IN_PROGRESS
}

enum CustomerSize {
    MICRO
    SMALL
    MEDIUM
    LARGE
    ENTERPRISE
}

enum CustomerPriority {
    LOW
    MEDIUM
    HIGH
}

enum CustomerSegment {
    VIP
    GOLD
    SILVER
    BRONZE
    STANDARD
}

/**
 * enum LeadStatus {
 * NEW
 * CONTACTED
 * QUALIFIED
 * PROPOSAL
 * NEGOTIATION
 * CLOSED_WON
 * CLOSED_LOST
 * }
 */

enum CompanyTypeEntity {
    JURIDICAL // Persona Giuridica (Azienda)
    NATURAL // Persona Fisica (Privato/Ditta individuale)
    FOREIGN // Entità Estera
}

// Enum per stato azienda
enum CompanyStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    ARCHIVED
}

// Tabella Company (base comune)
model Company {
    id Int @id @default(autoincrement())

    // Dati Base
    code        String  @unique @db.VarChar(20)
    companyName String  @db.VarChar(255)
    tradeName   String? @db.VarChar(255)
    legalForm   String? @db.VarChar(100)

    status CompanyStatus @default(ACTIVE)

    // Tipo Persona (per differenziare l'uso di CF o P.IVA)
    entityType CompanyTypeEntity @default(JURIDICAL)

    // Dati Fiscali ITALIANI (SdI)
    vatNumber String? @db.VarChar(20) // Partita IVA
    taxCode   String? @db.VarChar(20) // Codice Fiscale

    // Codice Destinatario (o SDI/PEC)
    sdiCode String? @db.VarChar(7) // Codice SDI (7 caratteri, '0000000' per i privati/esteri)
    pec     String? @db.VarChar(255) // Indirizzo PEC

    // Dati Fiscali ESTERI (necessari se Country non è IT)
    eoriNumber String? @db.VarChar(20) // EORI (per transazioni extra UE)
    vatId      String? @db.VarChar(20) // VAT ID per UE (es. FR123456789)

    // Nazione Fiscale
    countryCode String  @default("IT") @db.Char(2)
    country     Country @relation("CompanyCountry", fields: [countryCode], references: [code])

    // Regime fiscale
    taxRegime String? @db.VarChar(20) // "ordinario", "semplificato", "forfettario"

    // Contatti Generali
    mainEmail String? @db.VarChar(255)
    mainPhone String? @db.VarChar(50)

    // Campi per tracking
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    firstOrderDate DateTime?
    totalOrders    Int       @default(0)
    totalRevenue   Decimal   @default(0) @db.Decimal(15, 2)

    // Relazioni
    user           User?      @relation("AssignedUser", fields: [assignedUserId], references: [id])
    assignedUserId Int?
    activities     Activity[]

    // Indirizzi
    addresses CompanyAddress[] @relation("CompanyAddresses")

    contacts  Contact[]
    customers Customer[]
    suppliers Supplier[]
    tenants TenantSettings[] @relation("TenantCompany")

    // Documenti
    documents Document[]

    // Note
    notes CompanyNote[]

    // Custom Fields
    customFields Json?

    // Opening Hours
    openingHours Json?

    // Index
    @@index([vatNumber])
    @@index([taxCode])
}

// Tabella Customer
model Customer {
    id Int @id @default(autoincrement())

    // Collegamento 1-a-1 alla Company
    companyId Int     @unique
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    // Dati specifici Cliente/CRM
    priority     CustomerPriority  @default(LOW)
    segment      CustomerSegment   @default(STANDARD)
    //leadStatus   LeadStatus        @default(NEW)
    size         CustomerSize      @default(SMALL)
    type         CustomerType      @default(PROSPECT)
    creditStatus CreditCheckStatus @default(PENDING)

    // Dati Commerciali
    defaultPriceListId Int?
    defaultPriceList   PriceList? @relation(fields: [defaultPriceListId], references: [id])

    customerTaxRuleId Int?
    customerTaxRule   TaxRule? @relation("CustomerTaxRule", fields: [customerTaxRuleId], references: [id])

    paymentMethodId Int?
    paymentMethod   PaymentMethod? @relation("CompanyPaymentMethod", fields: [paymentMethodId], references: [id])

    creditLimit Decimal? @db.Decimal(15, 2) // Limite di credito CONCESSO al Cliente

    // Tracking/Reportistica
    firstSaleDate DateTime? // Prima vendita CONFERMATA
    lastSaleDate  DateTime? // Ultima vendita CONFERMATA
    totalSales    Int       @default(0) // Numero ordini TOTALI
    totalRevenue  Decimal   @default(0) @db.Decimal(15, 2) // Fatturato TOTALE reale

    // Date estese
    customerSince     DateTime? // Data entrata in CRM (può essere prima di firstSaleDate)
    lastInteractionAt DateTime? // Ultima attività (vendita, email, call, meeting)

    // Metriche calcolate
    averageOrderValue Decimal @default(0) @db.Decimal(15, 2) // Fatturato medio ( totalRevenue / totalSales )
    lifetimeValue     Decimal @default(0) @db.Decimal(15, 2) // LTV (storico + proiezione)

    // Score predittivi
    churnRisk   Int @default(0) @db.SmallInt // 0-100 (rischio abbandono)
    healthScore Int @default(50) @db.SmallInt // 0-100 (salute complessiva)

    // NPS e soddisfazione
    npsScore         Int?      @db.SmallInt // -100 a +100
    satisfactionRate Decimal?  @db.Decimal(3, 2) // 0.00 - 5.00
    lastSurveyDate   DateTime?

    // Relazioni a documenti di Vendita
    documentsOut  Document[]    @relation("CustomerDocuments")
    opportunities Opportunity[]
    activities    Activity[]

    // Lead convertita in questo customer
    convertedFromLead Lead? @relation("ConvertedCustomer")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    deletedBy Int?
    deletedByUser User? @relation("DeletedBy", fields: [deletedBy], references: [id])

    @@index([deletedAt])

    //@@index([leadStatus])
}

// Tabella Supplier
model Supplier {
    id Int @id @default(autoincrement())

    // Collegamento 1-a-1 alla Company
    companyId Int     @unique
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    // Dati specifici Fornitore
    paymentTerms String?  @db.VarChar(100) // Es. 30 giorni data fattura fine mese
    creditLimit  Decimal? @db.Decimal(15, 2) // Limite di credito CONCESSO dal Fornitore
    bankAccount  String?  @db.VarChar(100) // IBAN per bonifici in USCITA

    // Costi e Logistica
    leadTimeDays  Int?     @default(0) // Tempo standard di consegna
    transportCost Decimal? @db.Decimal(10, 2)

    // Tracking/Reportistica
    firstOrderDate DateTime?
    lastOrderDate  DateTime?
    totalOrders    Int       @default(0)
    totalSpent     Decimal   @default(0) @db.Decimal(15, 2)
    rating         Int?      @default(5) // 1-5 stelle

    supplierTaxRuleId Int?
    supplierTaxRule   TaxRule? @relation("SupplierTaxRule", fields: [supplierTaxRuleId], references: [id])

    // Relazioni a documenti di Acquisto
    documentsIn Document[] @relation("SupplierDocuments")
    products    Product[]

    // Relazione stocks
    stockBatchs StockBatch[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    deletedAt DateTime?

    deletedBy Int?
    deletedByUser User? @relation("DeletedBy", fields: [deletedBy], references: [id])

    @@index([deletedAt])
}

// Enum per tipo indirizzo
enum AddressType {
    LEGAL
    BILLING
    SHIPPING
    OFFICE
    WAREHOUSE
    OTHER
}

model CompanyAddress {
    id Int @id @default(autoincrement())

    companyId Int
    company   Company @relation("CompanyAddresses", fields: [companyId], references: [id], onDelete: Cascade)

    addressType AddressType @default(LEGAL) // LEGAL, BILLING, SHIPPING, WAREHOUSE
    isPrimary   Boolean     @default(false)
    isLegal     Boolean     @default(false)

    // Campi base dell'indirizzo
    address String @db.VarChar(255)
    city    String @db.VarChar(100)

    // Provincia (Obbligatorio per IT SdI)
    provinceCode String? @db.Char(2) // Codice Provincia (es. MI, RM)

    zipCode String @db.VarChar(20)

    countryCode String  @default("IT") @db.Char(2)
    country     Country @relation("AddressCountry", fields: [countryCode], references: [code])

    // Decimal corretto per coordinate geografiche
    latitude  Decimal? @db.Decimal(10, 8) // Decimal(totale_cifre, decimali)
    longitude Decimal? @db.Decimal(11, 8)

    // Contatto specifico per questo indirizzo (es. telefono del magazzino)
    phone String? @db.VarChar(50)

    openingHours Json?
    notes        String? @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([companyId, addressType, isPrimary])
    @@index([companyId, isLegal])
    @@index([addressType])
    @@index([provinceCode])
}

model Contact {
    id        Int     @id @default(autoincrement())
    companyId Int
    company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

    firstName   String  @db.VarChar(100)
    lastName    String  @db.VarChar(100)
    email       String  @db.VarChar(255)
    phone       String? @db.VarChar(50)
    mobilePhone String? @db.VarChar(50)

    position   String? @db.VarChar(100)
    department String? @db.VarChar(100)

    isPrimaryContact Boolean @default(false)
    active           Boolean @default(true)

    notes String? @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    documents            Document[]
    activities           Activity[]
    activityParticipants ActivityParticipant[]

    // Un contatto unico per email all'interno di un'azienda.
    @@unique([companyId, email])
    // Unico contatto primario in azienda
    @@index([companyId, isPrimaryContact])
    @@index([companyId])
    @@index([email])
    @@index([isPrimaryContact]) // Utile per trovare velocemente il contatto principale
}

// Tabella Note
model CompanyNote {
    id        Int      @id @default(autoincrement())
    companyId Int
    company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
    title     String   @db.VarChar(255)
    content   String   @db.Text
    authorId  Int
    author    User     @relation(fields: [authorId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
