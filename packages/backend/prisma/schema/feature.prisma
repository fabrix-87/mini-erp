// ============================================================================
// FEATURE GROUP
// Dictionary of reusable specification groups.
// ============================================================================

/// Reusable specification group, e.g. material, dimensions, compatibility.
model FeatureGroup {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantFeatureGroups", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    /// Stable system identifier.
    code String @unique @db.VarChar(50)

    /// Display ordering hint.
    position Int @default(0)

    /// Controls whether this group can be exposed as a catalog filter.
    isFilterable Boolean @default(false) @map("is_filterable")

    translations  FeatureGroupTranslation[]
    features      Feature[]
    productValues ProductFeature[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([tenantId, id])
    @@unique([tenantId, code])
    @@index([tenantId, position])
    @@map("feature_groups")
}

// ============================================================================
// FEATURE GROUP TRANSLATION
// Localized labels for feature groups.
// ============================================================================

/// Localized name of a feature group. Tenant scope is inherited from the parent group.
model FeatureGroupTranslation {
    featureGroupId String       @map("feature_group_id")
    featureGroup   FeatureGroup @relation(fields: [featureGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    languageId Int      @map("language_id")
    language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    name String @db.VarChar(128)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@id([featureGroupId, languageId])
    @@index([languageId])
    @@map("feature_group_translations")
}

// ============================================================================
// FEATURE
// Reusable predefined values within a feature group.
// ============================================================================

/// Reusable predefined value belonging to a feature group.
model Feature {
    id String @id @default(cuid())

    /// Denormalized from FeatureGroup.tenantId; the composite FK below keeps them aligned.
    tenantId String @map("tenant_id")

    featureGroupId String       @map("feature_group_id")
    featureGroup   FeatureGroup @relation(fields: [tenantId, featureGroupId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    /// Stable system identifier unique within the same feature group.
    code String @db.VarChar(50)

    /// Display ordering within the same feature group.
    position Int @default(0)

    translations  FeatureTranslation[]
    productValues ProductFeature[]

    @@unique([tenantId, featureGroupId, id])
    @@unique([tenantId, featureGroupId, code])
    @@index([tenantId, featureGroupId])
    @@map("features")
}

// ============================================================================
// FEATURE TRANSLATION
// Localized labels for predefined feature values.
// ============================================================================

/// Localized display value of a predefined feature. Tenant scope is inherited from the parent feature.
model FeatureTranslation {
    featureId String  @map("feature_id")
    feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    languageId Int      @map("language_id")
    language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    value String @db.VarChar(255)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@id([featureId, languageId])
    @@index([languageId])
    @@map("feature_translations")
}

// ============================================================================
// PRODUCT FEATURE
// One value per product and feature group.
// The value can be predefined or custom, but never both.
// ============================================================================

/// Assigns a single feature-group value to a product.
model ProductFeature {
    /// Denormalized from Product.tenantId; the composite FKs keep product, group and feature in the same tenant.
    tenantId String @map("tenant_id")

    productId String  @map("product_id")
    product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    featureGroupId String       @map("feature_group_id")
    featureGroup   FeatureGroup @relation(fields: [tenantId, featureGroupId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    /// Predefined reusable value selected for the group.
    featureId String?  @map("feature_id")
    feature   Feature? @relation(fields: [tenantId, featureGroupId, featureId], references: [tenantId, featureGroupId, id], onDelete: Restrict, onUpdate: Cascade)

    /// Product-specific value used when no predefined feature applies.
    /// Expected shape: localized key/value object.
    customValue Json? @map("custom_value")

    position Int @default(0)

    @@id([productId, featureGroupId])
    @@index([tenantId, featureGroupId, featureId]) // FK checks on group/feature delete and "products with feature X" filters
    @@map("product_features")
}
