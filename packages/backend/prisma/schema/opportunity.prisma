// ============================================================================
// OPPORTUNITY MANAGEMENT
// ============================================================================

/// Overall outcome status of the opportunity.
enum OpportunityStatus {
  OPEN // Actively being worked
  WON // Successfully closed
  LOST // Lost to competitor or abandoned
  PENDING // Waiting for an external decision
  CLOSED // Generically closed without win/loss outcome
}

/// Current stage of the opportunity in the sales pipeline.
enum SalesStage {
  LEAD_QUALIFICATION // Assessing fit and interest
  PROSPECTING // Research and first contact
  NEEDS_ANALYSIS // Discovering requirements and pain points
  PROPOSAL_SENT // Proposal or quote submitted
  NEGOTIATION // Commercial negotiation in progress
  COMMITMENT // Verbal or written commitment received (pre-won)
}

/// Channel or event that originated the opportunity.
enum OpportunitySource {
  LEAD // Generated from a Lead record
  CUSTOMER // Existing customer upsell or cross-sell
  INBOUND // Unsolicited inbound request
  OUTBOUND // Result of an outbound action
  REFERRAL // Referral from a third party
  PARTNER // Commercial partner
  EVENT // Trade show, conference, or webinar
  OTHER // Other
}

/// Sales opportunity linked to a Lead and/or an existing Customer.
/// At least one of leadId or customerId must be non-null (enforced at application level).
/// Tracks pipeline stage, financial metrics, BANT probability, and closure outcome.
model Opportunity {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(255)
  description String? @db.Text

  // === LEAD / CUSTOMER LINK ===
  // An opportunity can be linked to a Lead (before conversion),
  // a Customer (upsell/cross-sell), or both (post-conversion traceability).
  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Tenant that owns this opportunity. All opportunity data is tenant-isolated.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation("TenantOpportunities", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  source OpportunitySource @default(OTHER)
  status OpportunityStatus @default(OPEN)
  /// Current pipeline stage. Should drive the probability value.
  stage  SalesStage        @default(LEAD_QUALIFICATION)

  // === FINANCIAL METRICS ===

  estimatedValue Decimal? @map("estimated_value") @db.Decimal(15, 2)
  /// Computed: weightedValue = estimatedValue * (probability / 100). Updated at application level.
  weightedValue  Decimal  @default(0) @map("weighted_value") @db.Decimal(15, 2)
  /// Win probability percentage (0–100). Should be aligned with the current stage.
  probability    Int      @default(0)
  /// Actual closed value. Populated when status = WON.
  actualValue    Decimal? @map("actual_value") @db.Decimal(15, 2)

  // === KEY DATES ===

  expectedCloseDate DateTime? @map("expected_close_date")
  closedDate        DateTime? @map("closed_date")

  // === CLOSURE ===

  closedReasonId String?       @map("closed_reason_id")
  closedReason   ClosedReason? @relation(fields: [closedReasonId], references: [id])
  /// Free-text notes on the closure outcome. Useful for win/loss analysis.
  closedNotes    String?       @map("closed_notes") @db.Text

  // === OWNERSHIP ===

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Sales rep responsible for this opportunity.
  assignedUserId  String? @map("assigned_user_id")
  assignedUser    User?   @relation("AssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)

  // === STAGE TRACKING ===

  /// Timestamp of the last stage transition. NULL = stage never changed. Used to detect stagnation.
  lastStageChange    DateTime? @map("last_stage_change")
  /// Denormalized count of days in the current stage. Updated by a scheduled job — do not write directly.
  daysInCurrentStage Int       @default(0) @map("days_in_current_stage")

  // === ACTIVITY COUNTERS ===

  /// Denormalized total activity count. Updated at application level.
  totalActivities  Int       @default(0) @map("total_activities")
  lastActivityDate DateTime? @map("last_activity_date")

  // === PRODUCTS / SERVICES ===

  /// Proposed items
  products OpportunityProduct[]

  // === NOTES AND CUSTOM FIELDS ===

  notes        String? @db.Text
  customFields Json?   @map("custom_fields")

  // === RELATIONS ===

  documents  Document[]
  activities Activity[] @relation("OpportunityActivities")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, stage])
  @@index([tenantId, source])
  @@index([assignedUserId])
  @@index([expectedCloseDate])
  @@index([closedDate])
  @@map("opportunities")
}

/// Line item proposed within a sales opportunity.
/// Linked to a specific ProductVariant (every product has at least one base variant).
/// The base price is resolved from PriceListItem at creation and can be overridden
/// for custom offers. Structure mirrors DocumentLine for frictionless conversion.
model OpportunityProduct {
  id            String      @id @default(cuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  // === PRODUCT LINK ===

  /// Specific variant selected. Restrict: cannot delete a variant in an active opportunity.
  productVariantId String         @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  /// Denormalized from productVariant for statistical grouping (mirrors DocumentLine pattern).
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Tenant denormalized for direct filtering without joining Opportunity.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation("TenantOpportunityProducts", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // === DESCRIPTIONS (snapshot at line creation) ===

  /// Variant/product name at time of proposal. Survives product renames.
  nameSnapshot        String  @map("name_snapshot") @db.VarChar(255)
  descriptionSnapshot String? @map("description_snapshot") @db.Text

  // === QUANTITIES AND PRICING ===

  quantity Decimal @default(1) @db.Decimal(15, 6)
  unit     String  @default("pz") @db.VarChar(20)

  /// Active list price resolved from PriceListItem at line creation.
  /// Preserved as audit trail even if the price list changes later.
  listPrice Decimal @map("list_price") @db.Decimal(20, 6)

  /// Actual proposed price. Equals listPrice unless manually overridden.
  unitPrice Decimal @map("unit_price") @db.Decimal(20, 6)

  /// Non-null when unitPrice != listPrice. Mandatory justification for price deviation.
  priceOverrideReason String? @map("price_override_reason") @db.Text

  /// PriceListItem used to resolve listPrice. NULL if no active price list matched
  /// (fallback to ProductVariant.price or Product.price).
  priceListItemId String?       @map("price_list_item_id")
  priceListItem   PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: SetNull)

  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @map("discount_amount")  @db.Decimal(15, 2)

  /// Line subtotal: (unitPrice × quantity) − discount. Excludes VAT (no fiscal context here).
  lineTotal Decimal @default(0) @map("line_total") @db.Decimal(15, 2)

  // === LINE CONTROL ===

  lineNumber Int     @default(0) @map("line_number")
  notes      String? @db.Text

  // === CONVERSION TRACKING ===

  /// True once this line has been included in at least one converted Document.
  /// Prevents duplicate conversion; frontend uses this to pre-select/deselect lines.
  converted   Boolean   @default(false)
  convertedAt DateTime? @map("converted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@index([opportunityId, lineNumber])
  @@index([tenantId, productVariantId])
  @@index([tenantId, productId])
  @@index([priceListItemId])
  @@index([converted])
  @@map("opportunity_products")
}

// ============================================================================
// WIN / LOSS REASONS
// ============================================================================

/// Tenant-scoped or global reason for closing an opportunity as won or lost.
/// Global reasons (tenantId NULL) are shared across all tenants as system defaults.
/// Tenants can define private reasons in addition to or instead of global ones.
model ClosedReason {
  id   String @id @default(cuid())
  /// Mnemonic code (e.g. PRICE, COMPETITOR, NO_BUDGET).
  /// Unique per scope: global (tenantId NULL) or per-tenant.
  code String @db.VarChar(50)

  /// true = win reason; false = loss reason.
  isWon        Boolean @map("is_won")
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantOpportunityClosedReasons", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  opportunities Opportunity[]
  translations  ClosedReasonTranslation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@unique([code], where: { tenantId: null }, map: "unique_global_closed_reason_code")
  @@index([isWon])
  @@index([active])
  @@map("closed_reasons")
}

/// Localized name and description for a ClosedReason.
model ClosedReasonTranslation {
  id             String       @id @default(cuid())
  closedReasonId String       @map("closed_reason_id")
  closedReason   ClosedReason @relation(fields: [closedReasonId], references: [id], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  /// Localized label shown in UI and documents (e.g. "Prezzo", "Price").
  name        String  @db.VarChar(255)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([closedReasonId, languageId])
  @@index([languageId])
  @@map("closed_reason_translations")
}
