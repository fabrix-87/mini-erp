// ============================================================================
// DOCUMENTI (ORDINI, FATTURE, PREVENTIVI)
// ============================================================================

// tipo di documento
enum DocumentType {
    // Principali
    QUOTE // Preventivo
    PROFORMA // Proforma
    ORDER // Ordine Cliente (Sales Order)
    DELIVERY_NOTE // Documento di Trasporto (DDT)
    INVOICE // Fattura
    CREDIT_NOTE // Nota di Credito
    DEBIT_NOTE // Nota di Debito (raro, ma possibile)
    SUPPLIER_ORDER // Ordine a Fornitore
    ARCHIVED // Documento archiviato o non classificato
}

enum DocumentStatusCategory {
    DRAFT_PHASE // Stati di lavorazione
    APPROVAL_PHASE // Stato di invio
    ACTIVE_PHASE // Stati di accettazione
    FULFILLMENT_PHASE // Stati logistici/fiscali
    PAYMENT_PHASE // Stati finanziari
    CLOSED_PHASE // Stati finali
}

enum DocumentStatus {
    // Stati di lavorazione
    DRAFT // Bozza (non ancora numerato)
    PENDING_APPROVAL // In attesa di approvazione interna

    // Stati di invio/accettazione
    SENT // Inviato (a Cliente)
    ACCEPTED // Accettato (dal Cliente)
    REJECTED // Rifiutato (dal Cliente)

    // Stati logistici/fiscali
    PREPARING // In preparazione (picking)
    PARTIALLY_FULFILLED // Evasione parziale (alcuni item spediti)
    FULFILLED // Totalmente evaso (tutti item pronti)
    IN_TRANSIT // In transito (per DDT)
    DELIVERED // Consegnato (per DDT)

    // Stati finanziari
    UNPAID // Non pagato (In attesa)
    PARTIALLY_PAID // Pagato parzialmente
    PAID // Pagato (Chiuso)
    OVERDUE // Scaduto

    // Stati finali
    VOIDED // Annullato/Non valido
    CLOSED // Chiuso (Generico, per chiudere il ciclo)
}

enum DocumentRelationType {
    CONVERTS_TO
    SPLITS_FROM
    MERGES_INTO
    CREDITS
    AMENDS
}

enum InstallmentStatus {
    PENDING // In attesa di pagamento
    PAID // Pagato completamente
    OVERDUE // Scaduto
    CANCELLED // Annullato
    PARTIAL // Pagato parzialmente (opzionale)
}

enum DocumentLineType {
    PRODUCT
    SERVICE
    DISCOUNT
    SUBTOTAL
    TEXT
    PAGE_BREAK
}

model Document {
    id Int @id @default(autoincrement())

    // Classificazione
    documentType   DocumentType
    statusCategory DocumentStatusCategory @default(DRAFT_PHASE)
    status         DocumentStatus         @default(DRAFT)

    // Numerazione
    documentNumber String? @unique
    sequenceNumber Int? // Numero progressivo nella sequenza
    documentYear   Int

    // Soggetti
    tenantId Int
    tenant   Tenant @relation("TenantDocuments", fields: [tenantId], references: [id])

    // RUOLO COMMERCIALE (Se è un documento di Vendita)
    customerId Int?
    customer   Customer? @relation("CustomerDocuments", fields: [customerId], references: [id])
    // RUOLO COMMERCIALE (Se è un documento di Acquisto)
    supplierId Int?
    supplier   Supplier? @relation("SupplierDocuments", fields: [supplierId], references: [id])

    contactId     Int?
    contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
    opportunityId Int?
    opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

    // Relazione con Lead
    leadId Int?
    lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

    // Magazzino di riferimento (Cruciale per DDT e Ordini)
    // Per vendita: Magazzino di partenza. Per acquisto: Magazzino di arrivo.
    warehouseId Int?
    warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

    // Date
    documentDate DateTime  @default(now())
    dueDate      DateTime? // Scadenza della prima rata o media
    deliveryDate DateTime?
    validUntil   DateTime?
    sentDate     DateTime?

    // Relazioni documento
    parentDocumentId Int?
    parentDocument   Document?  @relation("DocumentChain", fields: [parentDocumentId], references: [id])
    childDocuments   Document[] @relation("DocumentChain")

    // AGGIUNGERE: tabella junction per relazioni multiple
    relatedDocuments   DocumentRelation[] @relation("SourceDocument")
    relatedToDocuments DocumentRelation[] @relation("TargetDocument")

    // Dati cliente (snapshot)
    customerName      String
    customerVatNumber String?
    customerTaxCode   String?
    customerPec       String?
    customerSdiCode   String?

    customerAddress    String?
    customerCity       String?
    customerPostalCode String?
    customerProvince   String?

    // SNAPSHOT Country Cliente
    customerCountryCode String  @default("IT") @db.Char(2) // Sostituisce customerCountry
    customerCountry     Country @relation("DocumentCountry", fields: [customerCountryCode], references: [code])

    customerEmail String?
    customerPhone String?

    // Indirizzo spedizione
    shippingName       String?
    shippingAddress    String?
    shippingCity       String?
    shippingPostalCode String?
    shippingProvince   String?

    // SNAPSHOT Country Spedizione
    shippingCountryCode String?  @db.Char(2) // Sostituisce shippingCountry
    shippingCountry     Country? @relation("DocumentShippingCountry", fields: [shippingCountryCode], references: [code])

    // Importi    
    subtotal          Decimal  @default(0) @db.Decimal(15, 2)
    discountPercent   Decimal  @default(0) @db.Decimal(5, 2)
    discountAmount    Decimal  @default(0) @db.Decimal(15, 2)
    shippingCost      Decimal  @default(0) @db.Decimal(15, 2)
    shippingTaxAmount Decimal  @default(0) @db.Decimal(15, 2)
    taxableAmount     Decimal  @default(0) @db.Decimal(15, 2)
    taxAmount         Decimal  @default(0) @db.Decimal(15, 2)
    totalAmount       Decimal  @default(0) @db.Decimal(15, 2)
    paidAmount        Decimal  @default(0) @db.Decimal(15, 2)
    currencyCode      String   @default("EUR") @db.Char(3)
    currency          Currency @relation("DocumentCurrency", fields: [currencyCode], references: [code])

    // Snapshot tasso cambio al momento documento (per storicizzazione)
    exchangeRate     Decimal  @default(1.0) @db.Decimal(12, 6)
    exchangeRateDate DateTime @default(now())
    baseCurrencyCode String   @default("EUR") @db.Char(3)

    // Pagamento
    // FK al set di regole usate per calcolare la scadenza
    paymentMethodId  Int?
    paymentMethodRel PaymentMethod? @relation("DocumentPaymentMethod", fields: [paymentMethodId], references: [id], onDelete: SetNull)

    // Campi Snapshot (Mantengono i valori effettivi al momento della creazione)
    paymentMethod String  @default("bank_transfer") @db.VarChar(50) // Nome/Code snapshot
    paymentTerms  String? @db.VarChar(100) // Termine di pagamento descrittivo snapshot (es. 30gg Fine Mese)
    bankName      String? @db.VarChar(100)
    bankIban      String?
    bankSwift     String?

    // Note
    notes              String? @db.Text
    internalNotes      String? @db.Text
    termsAndConditions String? @db.Text

    // Metadata
    createdByUserId Int
    createdBy       User  @relation("CreatedBy", fields: [createdByUserId], references: [id])
    assignedUserId  Int?
    assignedUser    User? @relation("AssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
    deletedBy       Int?
    deletedByUser   User? @relation("DeletedBy", fields: [deletedBy], references: [id])

    customFields Json?

    // Storico transizioni stato
    statusHistory Json? // Array: [{from, to, by, at, reason}]

    // date importanti 
    approvedAt   DateTime?
    invoicedAt   DateTime?
    deliveredAt  DateTime?
    closedAt     DateTime?
    voidedAt     DateTime?
    voidedReason String?   @db.Text

    // Relazioni
    lines                 DocumentLine[]
    installments          DocumentPaymentInstallment[] // rate pagamento
    stockMovement         StockMovement[]
    stockReservations     StockReservation[]
    // Relazione alla transazione Intrastat
    intrastatTransactions IntrastatTransaction[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@unique([documentType, documentYear, sequenceNumber])
    @@index([currencyCode])
    @@index([deletedAt])
    @@index([documentType])
    @@index([status])
    @@index([tenantId])
    @@index([tenantId, documentType])
    @@index([tenantId, status])
    @@index([customerId])
    @@index([supplierId])
    @@index([opportunityId])
    @@index([leadId])
    @@index([documentYear])
    @@index([customerCountryCode])
    @@index([shippingCountryCode])
    @@index([documentType, documentYear, documentNumber])
    @@index([deletedAt, documentType])
    @@index([deletedAt, customerId])
    @@index([deletedAt, supplierId])
    @@index([deletedAt, status])
}

model DocumentLine {
    id         Int      @id @default(autoincrement())
    documentId Int
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    // COLLEGAMENTO CORE: Variante Prodotto
    // Opzionale perché la riga potrebbe essere un servizio "libero" o una nota
    productVariantId Int?
    productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

    // Opzionale: Link al prodotto padre per raggruppamenti statistici facili
    productId Int?
    product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

    lineNumber Int
    lineType   DocumentLineType @default(PRODUCT)

    code String?

    // Campo 1: Descrizione nella lingua del compilatore/sistema (Originale)
    nameSystem        String  @db.VarChar(255) // Nome dell'articolo nella lingua di base
    descriptionSystem String? @db.Text

    // Campo 2: Descrizione nella lingua del cliente (Tradotta)
    nameCustomer        String? @db.VarChar(255) // Nome dell'articolo nella lingua del cliente
    descriptionCustomer String? @db.Text

    quantity Decimal @default(1) @db.Decimal(15, 6)
    unit     String  @default("pz")

    unitPrice Decimal @default(0) @db.Decimal(20, 6)
    unitCost  Decimal @default(0) @db.Decimal(20, 6)

    discountPercent Decimal @default(0) @db.Decimal(5, 2)
    discountAmount  Decimal @default(0) @db.Decimal(15, 2)

    lineTotal Decimal @default(0) @db.Decimal(15, 2)

    // Regola fiscale applicata
    taxRuleId Int?
    taxRule   TaxRule? @relation("DocumentLineTaxRule", fields: [taxRuleId], references: [id], onDelete: SetNull)

    // Snapshot valori al momento documento
    taxPercent Decimal @default(22) @db.Decimal(5, 2)
    taxAmount  Decimal @default(0) @db.Decimal(15, 2)

    // Natura IVA utilizzata (snapshot)
    vatNatureCode String? @db.VarChar(10) // N2.1, N3.2, ecc.

    // Riferimento normativo utilizzato (per XML fattura elettronica)
    vatNormReference String? @db.VarChar(255)

    lineTotalWithTax Decimal @default(0) @db.Decimal(15, 2)

    notes        String? @db.Text
    customFields Json?

    // Relazione alla transazione Intrastat
    intrastatTransaction IntrastatTransaction?

    // tracking magazzino
    warehouseId Int?
    warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

    stockReservations StockReservation[]
    stockMovement     StockMovement[]

    // gestione kit/bundle
    parentLineId   Int?
    parentLine     DocumentLine?  @relation("LineComponents", fields: [parentLineId], references: [id])
    componentLines DocumentLine[] @relation("LineComponents")

    isComponent Boolean @default(false) // True se fa parte di un kit

    // tracking evasione
    quantityInvoiced  Decimal @default(0) @db.Decimal(15, 6)
    quantityDelivered Decimal @default(0) @db.Decimal(15, 6)
    quantityReturned  Decimal @default(0) @db.Decimal(15, 6)

    // prezzi originali per storico
    originalUnitPrice   Decimal? @db.Decimal(20, 6)
    priceOverrideReason String?  @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([warehouseId])
    @@index([parentLineId])
    @@index([documentId, lineNumber]) // Ordinamento righe
    @@index([documentId])
    @@index([productId])
}

model DocumentPaymentInstallment {
    id         Int      @id @default(autoincrement())
    documentId Int
    document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

    // Dati della rata
    installmentNumber Int     @default(1)
    percentage        Decimal @db.Decimal(5, 2) // 30.00, 40.00, etc.
    amount            Decimal @default(0) @db.Decimal(15, 2) // Importo effettivo in valuta

    // Date e Status (Snapshot)
    dueDate    DateTime // La data di scadenza CALCOLATA
    paidDate   DateTime? // Data di pagamento effettivo
    paidAmount Decimal           @default(0) @db.Decimal(15, 2)
    status     InstallmentStatus @default(PENDING)

    notes String? @db.Text

    // metodo pagamento specifico per rata
    paymentMethodId Int?
    paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

    // riferimenti transazioni
    paymentReference  String? @db.VarChar(100) // CRO, TRN, ecc.
    bankTransactionId String? @db.VarChar(100)

    // gestione solleciti
    remindersSent  Int       @default(0)
    lastReminderAt DateTime?

    // penali ritardo
    lateFeeAmount Decimal @default(0) @db.Decimal(15, 2)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status, dueDate]) // Solleciti automatici
    @@index([documentId])
    @@index([dueDate])
    @@index([status])
}

// tabella per gestire sequenze
model DocumentSequence {
    id           Int          @id @default(autoincrement())
    documentType DocumentType 
    year         Int
    lastNumber   Int          @default(0)
    prefix       String?      @db.VarChar(10) // Es. "FT", "DDT", "PRV" 
    tenantId     Int
    tenant       Tenant       @relation("TenantSequences", fields: [tenantId], references: [id])

    updatedAt DateTime @updatedAt

    @@unique([tenantId, documentType, year])
    @@index([tenantId])
}

// gestione relazioni complesse
model DocumentRelation {
    sourceDocumentId Int
    sourceDocument   Document @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)

    targetDocumentId Int
    targetDocument   Document @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)

    relationType DocumentRelationType

    createdAt DateTime @default(now())

    @@id([sourceDocumentId, targetDocumentId, relationType])
    @@index([targetDocumentId])
}
