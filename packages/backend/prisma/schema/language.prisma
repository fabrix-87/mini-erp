// ============================================================================
// LANGUAGE MASTER DATA
// Central dictionary for localization support across the entire system.
// ============================================================================

/// System language definitions for i18n support.
model Language {
  id Int @id @default(autoincrement())

  /// Native language name (e.g., "Italiano", "English").
  name String @unique @db.VarChar(50)

  /// ISO 639-1 two-letter code (e.g., "it", "en"). Primary key for URL routing.
  isoCode String @unique @map("iso_code") @db.Char(2)

  /// BCP 47 language tag (e.g., "it_IT", "en_US"). Used for locale-specific formatting.
  languageCode String @unique @map("language_code") @db.Char(5)

  // i18n Relations: central point for all localized entity lookups.
  usersPreferred                       User[]                                @relation("UserPreferredLanguage")
  productTranslations                  ProductTranslation[]
  productImageTranslations             ProductImageTranslation[]
  categoryTranslations                 CategoryTranslation[]
  paymentMethodTranslations            PaymentMethodTranslation[]
  taxRuleTranslations                  TaxRuleTranslation[]
  attributeTranslations                AttributeTranslation[]
  attributeGroupTranslations           AttributeGroupTranslation[]
  vatNatureTranslations                VatNatureTranslation[]
  tenant                               Tenant[]
  countries                            Country[]
  currencyTranslations                 CurrencyTranslation[]
  featureGroupTranslation              FeatureGroupTranslation[]
  featureTranslations                  FeatureTranslation[]
  intrastatTransactionCodeTranslations IntrastatTransactionCodeTranslation[]
  intrastatCommodityCodeTranslations   IntrastatCommodityCodeTranslation[]
  intrastatTransportModeTranslations   IntrastatTransportModeTranslation[]
  closedReasonTranslations             ClosedReasonTranslation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isoCode])
  @@map("languages")
}
