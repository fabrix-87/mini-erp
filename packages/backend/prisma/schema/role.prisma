model Role {
  id              Int           @id @default(autoincrement())
  
  // Codice univoco (per lookup nel codice)
  code            String        @unique @db.VarChar(50) // ADMIN, WAREHOUSE, SALES
  
  name            String        @db.VarChar(100)
  description     String?       @db.Text
  
  isDefault       Boolean       @default(false) // Ruolo assegnato di default ai nuovi utenti
  
  // Relazioni
  users           User[]        @relation("UserRoles")
  permissions     RolePermission[]

  // gerarchia ruoli
    parentRoleId Int?
    parentRole   Role?  @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
    childRoles   Role[] @relation("RoleHierarchy")
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Permission {
  id              Int           @id @default(autoincrement())
  
  // Nome del permesso (es. product:read, invoice:create)
  code            String        @unique @db.VarChar(100)
  
  resource        String        @db.VarChar(50) // Es. product, document, company
  action          String        @db.VarChar(50) // Es. read, create, update, delete, approve, export
  scope           String        @default("own") @db.VarChar(20) // "own", "team", "all"

  description     String?       @db.Text
  
  // Relazioni
  roles           RolePermission[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([resource, action, scope])
}

model RolePermission {
  roleId          Int
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId    Int
  permission      Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  // Chiave primaria composta
  @@id([roleId, permissionId])
  @@index([permissionId])
}

// log modifiche per compliance
model AuditLog {
    id         String   @id @default(uuid())
    
    entityType String   @db.VarChar(50) // "Product", "Document", "Customer"
    entityId   Int
    
    action     String   @db.VarChar(20) // "create", "update", "delete"
    
    userId     Int?
    user       User?    @relation(fields: [userId], references: [id])
    
    changes    Json     // {field: {old: x, new: y}}
    metadata   Json?    // IP, user agent, etc.
    
    createdAt  DateTime @default(now())
    
    @@index([entityType, entityId])
    @@index([userId])
    @@index([createdAt])
}
