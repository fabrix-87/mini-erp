// ============================================================================
// UNITS OF MEASURE
// Tenant-scoped; standard units are seeded per tenant at provisioning.
// Universal conversions live here (same category); product-specific
// packaging conversions live in ProductUom.
// ============================================================================

enum UomCategory {
    UNIT // pz, dozen
    PACKAGING // box, pallet — no universal factor, always product-specific
    WEIGHT
    LENGTH
    AREA
    VOLUME
    TIME
}

/// Tenant-scoped unit of measure with a universal conversion factor within its category.
model UnitOfMeasure {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantUnitsOfMeasure", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    /// Printed on documents and sent in FatturaPA <UnitaMisura> (max 10 chars).
    code String @db.VarChar(10)
    name String @db.VarChar(100)

    /// UN/ECE Recommendation 20 code, used for interoperability (e.g. "C62", "KGM").
    uneceCode String? @map("unece_code") @db.VarChar(3)

    category UomCategory

    /// Reference unit of its category (factor = 1). At most one per category per tenant.
    isBase Boolean @default(false) @map("is_base")

    /// Base units per 1 of this unit (e.g. g → 0.001 when kg is base). Ignored for PACKAGING.
    factor Decimal @default(1) @db.Decimal(20, 10)

    /// Maximum fractional digits allowed on quantities (pz = 0, kg = 3). Enforced by application/Zod.
    decimals Int @default(0)

    active Boolean @default(true)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    productsAsBase Product[]      @relation("ProductBaseUom")
    productUoms    ProductUom[]
    documentLines  DocumentLine[]

    @@unique([tenantId, id])
    @@unique([tenantId, code])
    @@unique([tenantId, category], where: { isBase: true }, map: "uq_uom_one_base_per_category")
    @@index([tenantId, category])
    @@map("units_of_measure")
}

/// Product-specific alternative unit (packaging) expressed in the product's base UoM.
/// The base UoM itself has no row here (implicit factor = 1).
model ProductUom {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")

    productId String  @map("product_id")
    product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    uomId String        @map("uom_id")
    uom   UnitOfMeasure @relation(fields: [tenantId, uomId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    /// Base units contained in 1 of this UoM (e.g. box of 12 pz → 12). Must be > 0 (CHECK in migration).
    factor Decimal @db.Decimal(20, 10)

    isSalesDefault    Boolean @default(false) @map("is_sales_default")
    isPurchaseDefault Boolean @default(false) @map("is_purchase_default")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([tenantId, productId, uomId])
    @@unique([tenantId, productId], where: { isSalesDefault: true }, map: "uq_product_uom_one_sales_default")
    @@unique([tenantId, productId], where: { isPurchaseDefault: true }, map: "uq_product_uom_one_purchase_default")
    @@index([tenantId, uomId])
    @@map("product_uoms")
}
