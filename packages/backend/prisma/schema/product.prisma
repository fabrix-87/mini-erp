// ============================================================================
// PRODUCT CATALOG MANAGEMENT
// Core product catalog architecture using a strict Master-Variant (Parent-Child)
// pattern to handle complex SKUs, localized metadata, and warehouse logistics.
// ============================================================================

enum ProductType {
    STANDARD
    PACK
    VIRTUAL
    SERVICE
}

enum ProductStatus {
    DRAFT
    ACTIVE
    ARCHIVED
}

enum ProductCondition {
    NEW
    USED
    REFURBISHED
}

enum ProductVisibility {
    BOTH
    CATALOG
    SEARCH
    NONE
}

/// Defines how stock is calculated for PACK type products.
enum PackStockType {
    USE_PACK_STOCK_ONLY // 0 - Decrement only the pack's own stock
    USE_PRODUCTS_STOCK_ONLY // 1 - Decrement only the components' stock
    USE_BOTH_STOCKS // 2 - Decrement both pack and components
}

/// Behavior when a variant is out of stock.
enum OutOfStockType {
    DENY_ORDERS // 0 - Block order placement
    ALLOW_ORDERS // 1 - Allow orders regardless
    USE_DEFAULT // 2 - Follow tenant-level default setting
}

/// HTTP redirect strategy applied when the product is deactivated or archived.
enum ProductRedirectType {
    NOT_FOUND // 404 - No redirect, return not found
    MOVED // 301 - Permanent redirect to redirectTarget
    TEMPORARY // 302 - Temporary redirect to redirectTarget
}

/// Catalog product master record. Represents the generic umbrella entity.
model Product {
    id     String        @id @default(cuid())
    type   ProductType   @default(STANDARD)
    status ProductStatus @default(DRAFT)

    /// Tenant that owns this product. All catalog data is tenant-isolated.
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantProducts", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    /// Global internal manufacturer/factory fallback code.
    reference String @db.VarChar(64)

    active            Boolean @default(true)
    availableForOrder Boolean @default(true) @map("available_for_order")
    showPrice         Boolean @default(true) @map("show_price")
    onlineOnly        Boolean @default(false) @map("online_only")
    onSale            Boolean @default(false) @map("on_sale")

    /// Fallback base retail price. Actual transactional prices reside on ProductVariant.
    price          Decimal @default(0) @db.Decimal(20, 6)
    wholesalePrice Decimal @default(0) @map("wholesale_price") @db.Decimal(20, 6)
    ecotax         Decimal @default(0) @db.Decimal(20, 6)

    defaultTaxRuleId Int?     @map("default_tax_rule_id")
    defaultTaxRule   TaxRule? @relation("ProductTaxRule", fields: [defaultTaxRuleId], references: [id])

    visibility    ProductVisibility @default(BOTH)
    condition     ProductCondition  @default(NEW)
    showCondition Boolean           @default(false) @map("show_condition")

    manufacturerId String?       @map("manufacturer_id")
    manufacturer   Manufacturer? @relation(fields: [tenantId, manufacturerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    supplierId String?   @map("supplier_id")
    supplier   Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

    additionalShippingCost Decimal @default(0) @map("additional_shipping_cost") @db.Decimal(20, 6)

    /// Combined Nomenclature (NC8) customs tariff number for Intrastat reporting.
    commodityCode String?                 @map("commodity_code") @db.Char(8)
    commodity     IntrastatCommodityCode? @relation(fields: [commodityCode], references: [code])

    /// Controls which delivery time note is displayed on the storefront.
    /// 0 = disabled, 1 = show in-stock note, 2 = show out-of-stock note, 3 = show both.
    deliveryTimeNoteType Int @default(0) @map("delivery_time_note_type")

    /// Strategy fallback for handling 404/SEO mitigation when a product is deactivated.
    redirectType     ProductRedirectType @default(NOT_FOUND) @map("redirect_type")
    redirectTargetId String?             @map("redirect_target_id")
    redirectTarget   Product?            @relation("ProductRedirect", fields: [tenantId, redirectTargetId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
    redirectSources  Product[]           @relation("ProductRedirect")

    /// CDN or absolute URL for public catalog lists optimization.
    coverThumbnailUrl String? @map("cover_thumbnail_url") @db.VarChar(500)

    variants      ProductVariant[]
    images        ProductImage[]
    categories    ProductCategory[]
    documentLines DocumentLine[]
    translations  ProductTranslation[]

    // Audited Soft-Delete Layer
    deletedAt     DateTime? @map("deleted_at")
    deletedBy     String?   @map("deleted_by")
    deletedByUser User?     @relation("ProductDeletedBy", fields: [deletedBy], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    productFeatures     ProductFeature[]
    opportunityProducts OpportunityProduct[]
    carriers            ProductCarrier[]

    @@unique([tenantId, id])
    @@unique([tenantId, reference], where: { deletedAt: null })
    @@index([tenantId, status])
    @@index([tenantId, active])
    @@index([tenantId, supplierId], where: { supplierId: { not: null } })
    @@index([tenantId, manufacturerId], where: { manufacturerId: { not: null } })
    @@index([tenantId, redirectTargetId], where: { redirectTargetId: { not: null } })
    @@index([tenantId, deletedAt])
    @@map("products")
}

/// Translatable descriptive metadata for Product entities.
model ProductTranslation {
    /// Denormalized from Product.tenantId; enables per-tenant slug uniqueness and tenant-scoped router lookups.
    tenantId String @map("tenant_id")

    productId String  @map("product_id")
    product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    languageId Int      @map("language_id")
    language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    name             String  @db.VarChar(255)
    description      String? @db.Text
    shortDescription String? @map("short_description") @db.VarChar(500)
    tags             String? @db.VarChar(500)

    metaTitle       String? @map("meta_title") @db.VarChar(255)
    metaDescription String? @map("meta_description") @db.Text
    metaKeywords    String? @map("meta_keywords") @db.VarChar(500)

    /// SEO path string, unique per tenant and language. Router lookups must always include tenantId.
    slug String? @db.VarChar(255)

    availableNowLabel   String @default("In stock") @map("available_now_label") @db.VarChar(100)
    availableLaterLabel String @default("Available soon") @map("available_later_label") @db.VarChar(100)

    deliveryTimeInStockNote    String? @map("delivery_time_in_stock_note") @db.VarChar(255)
    deliveryTimeOutOfStockNote String? @map("delivery_time_out_of_stock_note") @db.VarChar(255)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@id([productId, languageId])
    @@unique([tenantId, languageId, slug])
    @@index([languageId])
    @@map("product_translations")
}

/// Transactional sellable stock unit (SKU). All physical and financial attributes live here.
model ProductVariant {
    id        String  @id @default(cuid())
    productId String  @map("product_id")
    product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    /// System generated immutable hash or variant identifier string.
    variantCode String @map("variant_code") @db.VarChar(64)

    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantProductVariants", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    /// Stock Keeping Unit. Primary transactional interface code for ERP/WMS systems.
    sku String @db.VarChar(64)

    ean13 String? @db.Char(13)
    upc   String? @db.Char(12)
    isbn  String? @db.VarChar(32)
    mpn   String? @db.VarChar(40)

    minimalQuantity      Int     @default(1) @map("minimal_quantity")
    lowStockThreshold    Int     @default(0) @map("low_stock_threshold")
    lowStockAlertEnabled Boolean @default(false) @map("low_stock_alert_enabled")

    /// Physical warehouse coordinates mapping (e.g., Aisle-Shelf-Bin).
    location String? @db.VarChar(50)

    packStockType  PackStockType  @default(USE_PACK_STOCK_ONLY) @map("pack_stock_type")
    outOfStockType OutOfStockType @default(DENY_ORDERS) @map("out_of_stock_type")
    availableDate  DateTime?      @map("available_date")

    /// Overrides parent product base price. Real checkout calculation target.
    price          Decimal? @db.Decimal(20, 6)
    wholesalePrice Decimal? @map("wholesale_price") @db.Decimal(20, 6)
    unitPriceRatio Decimal  @default(0) @map("unit_price_ratio") @db.Decimal(20, 8)

    weight Decimal? @default(0) @db.Decimal(20, 6)
    width  Decimal? @default(0) @db.Decimal(20, 6)
    height Decimal? @default(0) @db.Decimal(20, 6)
    depth  Decimal? @default(0) @db.Decimal(20, 6)

    position Int @default(0)

    /// Flips rendering priority to show this specific variant on global catalog views.
    isDefault         Boolean @default(false) @map("is_default")
    active            Boolean @default(true)
    availableForOrder Boolean @default(true) @map("available_for_order")

    metadata Json?

    attributes          ProductVariantAttribute[]
    stockMovements      StockMovement[]
    stockReservations   StockReservation[]
    stockBatches        StockBatch[]
    virtualStocks       VirtualStock[]
    documentLines       DocumentLine[]
    priceListItems      PriceListItem[]
    images              ProductImage[]
    opportunityProducts OpportunityProduct[]

    deletedAt     DateTime? @map("deleted_at")
    deletedBy     String?   @map("deleted_by")
    deletedByUser User?     @relation("ProductVariantDeletedBy", fields: [deletedBy], references: [id])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([tenantId, variantCode])
    @@unique([tenantId, id])
    @@unique([tenantId, productId, id]) // target of ProductImage composite FK
    @@unique([tenantId, sku], where: { deletedAt: null })
    @@unique([tenantId, ean13], where: { deletedAt: null, ean13: { not: null } })
    // one default variant per product
    @@unique([tenantId, productId], where: { isDefault: true, deletedAt: null }, map: "uq_variant_one_default_per_product")
    @@index([tenantId, productId, active])
    @@map("product_variants")
}

/// Image asset storage mapping with structural variant level inheritance overrides.
model ProductImage {
    id String @id @default(cuid())

    tenantId  String  @map("tenant_id")
    productId String  @map("product_id")
    product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

    /// Optional assignment fallback to bind a specific image to a single variant attribute subset.
    variantId String?         @map("variant_id")
    // MATCH SIMPLE: when variantId is NULL this FK is skipped
    variant   ProductVariant? @relation(fields: [tenantId, productId, variantId], references: [tenantId, productId, id], onDelete: Cascade, onUpdate: Cascade)

    imageUrl  String  @map("image_url") @db.VarChar(500)
    imageType String  @default("extra") @map("image_type") @db.VarChar(20)
    position  Int     @default(0)
    isCover   Boolean @default(false) @map("is_cover")

    translations ProductImageTranslation[]

    width    Int?
    height   Int?
    fileSize Int?
    mimeType String? @map("mime_type") @db.VarChar(50)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([tenantId, productId], where: { isCover: true, variantId: null }, map: "uq_image_one_product_cover")
    @@unique([tenantId, variantId], where: { isCover: true, variantId: { not: null } }, map: "uq_image_one_variant_cover")
    @@index([tenantId, productId, position])
    @@index([tenantId, productId, variantId], where: { variantId: { not: null } })
    @@map("product_images")
}

/// Localization for Image alternative text tags (SEO Alt tags optimization).
model ProductImageTranslation {
    productImageId String       @map("product_image_id")
    productImage   ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)

    languageId Int      @map("language_id")
    language   Language @relation(fields: [languageId], references: [id])

    description String? @db.Text

    @@id([productImageId, languageId])
    @@index([languageId])
    @@map("product_image_translations")
}

/// Explicit many-to-many junction table resolving category-to-product mapping trees.
model ProductCategory {
    productId String  @map("product_id")
    product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

    /// Denormalized from Product.tenantId; the composite FKs keep product and category in the same tenant.
    tenantId String @map("tenant_id")

    categoryId String   @map("category_id")
    category   Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

    position Int @default(0)

    @@id([productId, categoryId])
    @@index([tenantId, categoryId, position])
    @@map("product_categories")
}

/// Tenant-scoped brand/manufacturer registry.
/// Each tenant manages its own manufacturer list independently.
model Manufacturer {
    id     String  @id @default(cuid())
    name   String
    active Boolean @default(true)

    /// All catalog data is tenant-isolated.
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantManufacturers", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    customFields Json? @map("custom_fields")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    products Product[]

    @@unique([tenantId, id])
    @@unique([tenantId, name])
    @@map("manufacturers")
}
