// ============================================================================
// ATTRIBUTE SYSTEM
// Normalized attribute structure for product variations. 
// Uses EAV-like approach with strict relational integrity.
// ============================================================================

enum AttributeDisplayType {
  SELECT
  RADIO
  COLOR
  IMAGE
}

/// Logical grouping for attributes (e.g., "Color", "Size").
model AttributeGroup {
  id Int @id @default(autoincrement())

  /// Internal system slug (e.g., "color", "size").
  code String @unique @db.VarChar(50)

  /// External system mapping for ETL/Sync processes.
  externalCode String? @unique @map("external_code") @db.VarChar(100)

  /// Determines UI rendering strategy.
  displayType AttributeDisplayType @default(SELECT) @map("display_type")

  position Int     @default(0)
  isPublic Boolean @default(true) @map("is_public")

  translations AttributeGroupTranslation[]
  attributes   Attribute[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([position])
  @@map("attribute_groups")
}

/// Localization for AttributeGroup names.
model AttributeGroupTranslation {
  id Int @id @default(autoincrement())

  attributeGroupId Int            @map("attribute_group_id")
  attributeGroup   AttributeGroup @relation(fields: [attributeGroupId], references: [id], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  name        String  @db.VarChar(128)
  displayName String? @map("display_name") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([attributeGroupId, languageId])
  @@index([languageId])
  @@map("attribute_group_translations")
}

/// Specific attribute values (e.g., "Red", "XL").
model Attribute {
  id Int @id @default(autoincrement())

  attributeGroupId Int            @map("attribute_group_id")
  attributeGroup   AttributeGroup @relation(fields: [attributeGroupId], references: [id], onDelete: Cascade)

  /// Value identifier within the group context.
  code String @db.VarChar(50)

  /// Schema-less storage for specialized values (e.g., color hex codes, icon URLs).
  metadata Json?

  position Int @default(0)

  translations AttributeTranslation[]
  variants     ProductVariantAttribute[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([attributeGroupId, code])
  @@index([attributeGroupId])
  @@index([position])
  @@map("attributes")
}

/// Localization for Attribute values.
model AttributeTranslation {
  id Int @id @default(autoincrement())

  attributeId Int       @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  name String @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([attributeId, languageId])
  @@index([languageId])
  @@map("attribute_translations")
}

/// Junction table linking product variants to their specific attribute definitions.
model ProductVariantAttribute {
  productVariantId Int            @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  attributeId Int       @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productVariantId, attributeId])
  @@index([attributeId])
  @@map("product_variant_attribute")
}
