// ============================================================================
// ATTRIBUTE SYSTEM
// Normalized attribute structure for product variations. 
// Uses EAV-like approach with strict relational integrity.
// ============================================================================

enum AttributeDisplayType {
  SELECT
  RADIO
  COLOR
  IMAGE
}

/// Logical grouping for attributes (e.g., "Color", "Size").
model AttributeGroup {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation("TenantAttributeGroups", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Internal slug, unique within the tenant.
  code         String  @db.VarChar(50)
  /// External system mapping for ETL/Sync, unique within the tenant.
  externalCode String? @map("external_code") @db.VarChar(100)

  displayType AttributeDisplayType @default(SELECT) @map("display_type")
  position    Int                  @default(0)
  isPublic    Boolean              @default(true) @map("is_public")

  translations AttributeGroupTranslation[]
  attributes   Attribute[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@unique([tenantId, externalCode])
  @@index([tenantId, position])
  @@map("attribute_groups")
}

/// Localized name of an attribute group. Tenant scope is inherited from the parent group.
model AttributeGroupTranslation {
  attributeGroupId String         @map("attribute_group_id")
  attributeGroup   AttributeGroup @relation(fields: [attributeGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name        String  @db.VarChar(128)
  displayName String? @map("display_name") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([attributeGroupId, languageId])
  @@index([languageId])
  @@map("attribute_group_translations")
}

/// Specific attribute values (e.g., "Red", "XL").
/// Tenant-owned attribute value (e.g. "Red", "XL").
model Attribute {
  id String @id @default(cuid())

  /// Denormalized from AttributeGroup.tenantId; the composite FK below keeps them aligned.
  tenantId         String         @map("tenant_id")
  attributeGroupId String         @map("attribute_group_id")
  attributeGroup   AttributeGroup @relation(fields: [tenantId, attributeGroupId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  code     String @db.VarChar(50)
  metadata Json?
  position Int    @default(0)

  translations AttributeTranslation[]
  variants     ProductVariantAttribute[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, attributeGroupId, code])
  /// Target of the ProductVariantAttribute composite FK.
  @@unique([tenantId, attributeGroupId, id])
  @@index([tenantId, attributeGroupId, position])
  @@map("attributes")
}

/// Localized label of an attribute value. Tenant scope is inherited from the parent attribute.
model AttributeTranslation {
  attributeId String    @map("attribute_id")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  name String @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([attributeId, languageId])
  @@index([languageId])
  @@map("attribute_translations")
}

/// Links a variant to one attribute value. A variant holds at most one value per group.
model ProductVariantAttribute {
  tenantId         String @map("tenant_id")
  productVariantId String @map("product_variant_id")
  attributeGroupId String @map("attribute_group_id")
  attributeId      String @map("attribute_id")

  productVariant ProductVariant @relation(fields: [tenantId, productVariantId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  attribute      Attribute      @relation(fields: [tenantId, attributeGroupId, attributeId], references: [tenantId, attributeGroupId, id], onDelete: Restrict, onUpdate: Cascade)

  @@id([productVariantId, attributeId])
  @@unique([productVariantId, attributeGroupId])
  @@index([tenantId, attributeId])
  @@map("product_variant_attributes")
}
