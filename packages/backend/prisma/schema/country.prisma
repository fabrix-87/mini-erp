model Country {
  code        String  @id // IT, DE, FR…
  name        String
  isEU        Boolean @default(false) @map("is_eu")
  iso3        String  @db.VarChar(3)
  numericCode String  @map("numeric_code") @db.VarChar(3)
  phoneCode   String  @map("phone_code") @db.VarChar(4)
  continent   String
  active      Boolean

  currencyCode String   @default("EUR") @map("currency_code") @db.Char(3)
  currency     Currency @relation("CountryCurrency", fields: [currencyCode], references: [code])

  // Relazioni inverse
  companyAddresses CompanyAddress[] @relation("AddressCountry")
  companies        Company[]        @relation("CompanyCountry")
  userDetails      UserDetails[]    @relation("UserDetailCountry")

  documentCountry         Document[] @relation("DocumentCountry")
  documentShippingCountry Document[] @relation("DocumentShippingCountry")

  instrastatTransations IntrastatTransaction[] @relation("InstrastatPartnerCountry")

  leads Lead[] @relation("LeadCountry")

  taxRule TaxRule[]

  languages Language[]

  @@map("countries")
}
