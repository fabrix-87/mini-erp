// ============================================================================
// AUDIT LOGS & COMPLIANCE
// ============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  APPROVE
  REJECT
  LOCK
  UNLOCK
  ARCHIVE
  RESTORE
  SEND
  RECEIVE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PERMISSION_CHANGE
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

/// Log modifications for compliance.
model AuditLog {
  id String @id @default(uuid())

  // === ENTITY INFORMATION ===
  entityType String  @map("entity_type") @db.VarChar(50) // "Product", "Document", "Customer"
  entityId   Int     @map("entity_id") // ID dell'entità modificata
  entityName String? @map("entity_name") @db.VarChar(255) // Nome/descrizione dell'entità per facilità di lettura

  // === ACTION ===
  action   AuditAction
  severity AuditSeverity @default(INFO)

  // === USER INFORMATION ===
  userId   String? @map("user_id") // ID dell'utente
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username String  @db.VarChar(50) // Snapshot dello username (anche se user viene cancellato)

  // === CHANGE DETAILS ===
  // Struttura: {field: {old: x, new: y}}
  changes Json

  // Descrizione human-readable dell'azione
  description String? @db.Text

  // === METADATA ===
  // IP address, user agent, session ID, etc.
  metadata Json?

  // Request context
  ipAddress String? @map("ip_address") @db.VarChar(45) // IPv6 max length
  userAgent String? @map("user_agent") @db.VarChar(500) // User agent string
  requestId String? @map("request_id") @db.VarChar(100)
  sessionId String? @map("session_id") @db.VarChar(100)

  // API/Route information
  endpoint String? @db.VarChar(255) // API endpoint chiamato
  method   String? @db.VarChar(10) // HTTP method (GET, POST, etc.)

  // === COMPLIANCE & RETENTION ===
  // Per GDPR/compliance - indica se questo log è critico e non può essere cancellato
  isCritical       Boolean   @default(false) @map("is_critical")
  retentionExpires DateTime? @map("retention_expires") // Quando può essere cancellato per policy di retention

  // === CONTEXT ===
  // Per azioni che coinvolgono più entità correlate
  relatedEntityType String? @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   Int?    @map("related_entity_id")

  // Business context
  businessContext String? @map("business_context") @db.VarChar(100) // Es. "Invoice #2024-001", "Order #12345"

  // === TIMESTAMP ===
  createdAt DateTime @default(now()) @map("created_at")

  // === INDICES ===
  @@index([entityType, entityId])
  @@index([userId])
  @@index([username])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([retentionExpires])
  @@index([entityType, entityId, action]) // Composite per query specifiche
  @@index([userId, createdAt]) // Per user activity timeline
  @@map("audit_logs")
}

// ============================================================================
// SECURITY EVENTS (Estensione opzionale per eventi di sicurezza)
// ============================================================================

model SecurityEvent {
  id String @id @default(uuid())

  eventType String        @map("event_type") @db.VarChar(50) // "failed_login", "suspicious_activity", "unauthorized_access"
  severity  AuditSeverity @default(WARNING)

  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username String? @db.VarChar(50)
  email    String? @db.VarChar(255)

  ipAddress String  @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(500)
  location  String? @db.VarChar(255) // Geolocation (city, country)

  description String @db.Text
  details     Json? // Dettagli aggiuntivi dell'evento

  // Azione intrapresa
  actionTaken String? @map("action_taken") @db.VarChar(100) // "blocked", "alerted", "logged"

  // Se è stato risolto/gestito
  resolved     Boolean   @default(false)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id")
  resolvedBy   User?     @relation("ResolvedSecurityEvents", fields: [resolvedById], references: id)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([userId])
  @@index([ipAddress])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("security_events")
}
