// ============================================================================
// GESTIONE IVA E NATURE OPERAZIONI
// ============================================================================

enum VatNatureCategory {
  EXCLUDED // N1 - Escluse
  NOT_SUBJECT // N2.x - Non soggette
  NOT_TAXABLE // N3.x - Non imponibili
  EXEMPT // N4 - Esenti
  MARGIN // N5 - Regime del margine
  REVERSE // N6.x - Inversione contabile
  EU_VAT // N7 - IVA altro stato UE
}

// ============================================================================
// NATURE IVA (Codici obbligatori fattura elettronica)
// ============================================================================
model VatNature {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(10) // N1, N2.1, N2.2, N3.1, ecc.

  category VatNatureCategory

  description         String  @db.VarChar(500)
  extendedDescription String? @db.Text
  legalReference      String? @db.VarChar(255)

  applicableToEntityTypes String? @db.VarChar(10)
  validForSales           Boolean @default(true)
  validForPurchases       Boolean @default(false)
  vatReturnLine           String? @db.VarChar(10)
  requiresNormReference   Boolean @default(false)

  usageExamples    String? @db.Text
  operationalNotes String? @db.Text

  active       Boolean   @default(true)
  validFrom    DateTime  @default("2021-01-01T00:00:00Z")
  validTo      DateTime?
  displayOrder Int       @default(0)

  // Sostituzione codici legacy
  replacedByCode String?     @db.VarChar(10)
  replacedBy     VatNature?  @relation("VatNatureReplacement", fields: [replacedByCode], references: [code])
  replacements   VatNature[] @relation("VatNatureReplacement")

  // === RELAZIONI ===

  // Regole fiscali che usano questa natura
  taxRules TaxRule[]

  // Traduzioni
  translations VatNatureTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([category])
  @@index([active, displayOrder])
  @@index([validFrom, validTo])
}

model VatNatureTranslation {
  id          Int       @id @default(autoincrement())
  vatNatureId Int
  vatNature   VatNature @relation(fields: [vatNatureId], references: [id], onDelete: Cascade)

  languageId Int
  language   Language @relation(fields: [languageId], references: [id])

  description String  @db.VarChar(500)
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vatNatureId, languageId])
  @@index([languageId])
}

enum TaxRuleApplicability {
  SALES
  PURCHASES
  BOTH
}

enum TaxRuleCustomerType {
  B2B
  B2C
  PA // Pubblica Amministrazione
  FOREIGN
  ANY
}

// ============================================================================
// TAX RULE (Regole fiscali configurabili)
// ============================================================================
model TaxRule {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(20)

  name        String  @db.VarChar(255)
  description String? @db.Text

  // NULL = global system rule; NOT NULL = tenant-private rule
  tenantId Int?    @map("tenant_id")
  tenant   Tenant? @relation("TenantOwnedTaxRules", fields: [tenantId], references: [id], onDelete: Cascade)

  // === ALIQUOTA IVA ===
  rate Decimal @default(0) @db.Decimal(5, 2) // 0.00, 4.00, 5.00, 10.00, 22.00

  // === NATURA IVA (obbligatoria se rate = 0) ===
  vatNatureId        Int?       @map("vat_nature_id")
  vatNature          VatNature? @relation(fields: [vatNatureId], references: [id])
  normativeReference String?    @map("normative_reference") @db.VarChar(255)

  // === APPLICABILITÀ ===
  countryCode     String               @default("IT") @map("country_code") @db.Char(2)
  country         Country              @relation(fields: [countryCode], references: [code])
  applicableFor   TaxRuleApplicability @default(BOTH) @map("applicable_for") // "sales", "purchases", "both"
  productCategory String?              @map("product_category") @db.VarChar(50)
  customerType    TaxRuleCustomerType  @default(ANY) @map("customer_type")

  // === REGOLE SPECIALI ===
  isSplitPayment       Boolean @default(false) @map("is_split_payment")
  deductibilityPercent Decimal @default(100) @map("deductibility_percent") @db.Decimal(5, 2)
  vatDeductible        Boolean @default(true) @map("vat_deductible")

  // === VALIDITÀ ===
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  // === STATO ===
  active       Boolean @default(true)
  isDefault    Boolean @default(false) @map("is_default")
  displayOrder Int     @default(0) @map("display_order")
  color        String? @db.VarChar(7)

  // === RELAZIONI ===
  translations     TaxRuleTranslation[]
  customers        Customer[]           @relation("CustomerTaxRule")
  suppliers        Supplier[]           @relation("SupplierTaxRule")
  tenantsSales     Tenant[]             @relation("TenantDefaultSalesTaxRule")
  tenantsPurchases Tenant[]             @relation("TenantDefaultPurchasesTaxRule")
  priceListItems   PriceListItem[]      @relation("PriceListTaxRule")
  documentLines    DocumentLine[]       @relation("DocumentLineTaxRule")
  products         Product[]            @relation("ProductTaxRule")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([rate])
  @@index([vatNatureId])
  @@index([countryCode])
  @@index([active, isDefault])
  @@index([validFrom, validTo])
  @@index([applicableFor])
  @@index([tenantId])
  @@index([tenantId, active, isDefault]) // compound per lookup frequente
  @@map("tax_rules")
}

model TaxRuleTranslation {
  id        Int     @id @default(autoincrement())
  taxRuleId Int
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  languageId Int
  language   Language @relation(fields: [languageId], references: [id])

  name        String  @db.VarChar(255)
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxRuleId, languageId])
  @@index([languageId])
}
