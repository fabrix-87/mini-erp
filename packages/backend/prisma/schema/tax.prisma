// ============================================================================
// VAT MANAGEMENT AND OPERATION NATURES
// ============================================================================

/// Macro-category for VAT nature, aligned to SDI coding (N1–N7).
/// Used to group VatNature records in UI and for automatic selection logic.
enum VatNatureCategory {
  EXCLUDED // N1 - Excluded
  NOT_SUBJECT // N2.x - Not subject
  NOT_TAXABLE // N3.x - Not taxable
  EXEMPT // N4 - Exempt
  MARGIN // N5 - Margin scheme
  REVERSE // N6.x - Reverse charge
  EU_VAT // N7 - VAT of another EU member state
}

// ============================================================================
// VAT NATURES (Mandatory codes for electronic invoicing)
// ============================================================================

/// VAT nature codes required for SDI electronic invoicing (FatturaPA).
/// Global master data: no tenantId — shared across all tenants.
/// A nature code must be selected whenever the VAT rate is 0%.
model VatNature {
  id   Int    @id @default(autoincrement())
  /// Official SDI code (e.g. N1, N2.1, N2.2, N3.1). Used in the XML tag <Natura>.
  code String @unique @db.VarChar(10)

  /// Macro-category for grouping and automatic selection logic.
  category VatNatureCategory

  /// Short description for dropdowns and reports.
  description         String  @db.VarChar(500)
  /// Extended description for tooltips, contextual help, or internal documentation.
  extendedDescription String? @map("extended_description") @db.Text
  /// Legal reference (e.g. "Art. 8 DPR 633/72"). Useful for printouts and audits.
  legalReference      String? @map("legal_reference") @db.VarChar(255)

  // === APPLICABILITY ===

  /// Fiscal entity types for which this nature applies (e.g. "PA", "B2B").
  /// Free-form for now; consider a dedicated enum if logic becomes formalized.
  applicableToEntityTypes String? @map("applicable_to_entity_types") @db.VarChar(10)
  /// If true, this nature is selectable on sales document lines.
  validForSales           Boolean @default(true) @map("valid_for_sales")
  /// If true, this nature is selectable on purchase document lines.
  validForPurchases       Boolean @default(false) @map("valid_for_purchases")
  /// VAT return line this nature maps to (e.g. VP/VF reference).
  vatReturnLine           String? @map("vat_return_line") @db.VarChar(10)
  /// If true, any TaxRule using this nature must provide a normativeReference.
  requiresNormReference   Boolean @default(false) @map("requires_norm_reference")

  // === OPERATIONAL DOCUMENTATION ===

  /// Usage examples for operators — shown in tooltips or detail panels.
  usageExamples    String? @map("usage_examples") @db.Text
  /// Internal operational notes (not exposed to end customers).
  operationalNotes String? @map("operational_notes") @db.Text

  // === TEMPORAL VALIDITY ===

  active       Boolean   @default(true)
  /// Effective date of the SDI code. Default: mandatory FatturaPA introduction date.
  validFrom    DateTime  @default("2021-01-01T00:00:00Z") @map("valid_from")
  /// Expiry date. NULL = still in force.
  validTo      DateTime? @map("valid_to")
  displayOrder Int       @default(0) @map("display_order")

  // === LEGACY CODE REPLACEMENT ===

  /// SDI code that supersedes this one when deprecated (self-join on `code`).
  replacedByCode String?     @map("replaced_by_code") @db.VarChar(10)
  replacedBy     VatNature?  @relation("VatNatureReplacement", fields: [replacedByCode], references: [code])
  replacements   VatNature[] @relation("VatNatureReplacement")

  // === RELATIONS ===

  /// Tax rules referencing this nature (required when rate = 0).
  taxRules     TaxRule[]
  translations VatNatureTranslation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([active, displayOrder])
  @@index([validFrom, validTo])
  @@map("vat_natures")
}

/// Localized translations of VatNature (description + notes per active language).
model VatNatureTranslation {
  id          Int       @id @default(autoincrement())
  vatNatureId Int       @map("vat_nature_id")
  vatNature   VatNature @relation(fields: [vatNatureId], references: [id], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  description String  @db.VarChar(500)
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([vatNatureId, languageId])
  @@index([languageId])
  @@map("vat_nature_translations")
}

/// Direction of the document flow to which the tax rule applies.
enum TaxRuleApplicability {
  SALES
  PURCHASES
  BOTH
}

/// Counterparty type used for automatic TaxRule selection.
enum TaxRuleCustomerType {
  B2B
  B2C
  PA // Public Administration — subject to split payment
  FOREIGN
  ANY
}

// ============================================================================
// TAX RULE (Configurable fiscal rules for VAT rate and nature)
// ============================================================================

/// Fiscal rule combining VAT rate, SDI nature, and applicability conditions.
/// Can be global (tenantId NULL) or tenant-private (tenantId NOT NULL).
/// Used by DocumentLine, PriceListItem, Customer, Supplier, and Product
/// to determine the correct VAT treatment when issuing documents.
model TaxRule {
  id   Int    @id @default(autoincrement())
  /// Mnemonic code (e.g. "IVA22", "EXEMPT-N4", "RC-N6.1").
  /// Unique per scope: global (tenantId NULL) or per-tenant.
  code String @db.VarChar(20)

  name        String  @db.VarChar(255)
  description String? @db.Text

  // NULL = global system rule; NOT NULL = tenant-private rule
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantOwnedTaxRules", fields: [tenantId], references: [id], onDelete: Cascade)

  // === VAT RATE ===

  /// Applied VAT percentage (e.g. 0.00, 4.00, 10.00, 22.00).
  /// If 0.00, vatNatureId is required to populate the SDI <Natura> tag.
  rate Decimal @default(0) @db.Decimal(5, 2)

  // === VAT NATURE ===

  /// Required when rate = 0. Determines the <Natura> tag in the electronic invoice.
  vatNatureId        Int?       @map("vat_nature_id")
  vatNature          VatNature? @relation(fields: [vatNatureId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Rule-specific legal reference (e.g. "Art. 17 c.6 DPR 633/72").
  /// Mandatory if vatNature.requiresNormReference = true.
  normativeReference String?    @map("normative_reference") @db.VarChar(255)

  // === GEOGRAPHIC AND DOCUMENT APPLICABILITY ===

  /// Country of application (ISO 3166-1 alpha-2). Default: Italy.
  countryCode String  @default("IT") @map("country_code") @db.Char(2)
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  /// Document flow direction (sales / purchases / both).
  applicableFor   TaxRuleApplicability @default(BOTH) @map("applicable_for")
  /// Product or service category this rule specifically applies to (optional).
  productCategory String?              @map("product_category") @db.VarChar(50)
  /// Counterparty type. Used for automatic tax rule selection.
  customerType    TaxRuleCustomerType  @default(ANY) @map("customer_type")

  // === SPECIAL RULES ===

  /// If true, VAT is remitted directly by the customer (PA). Affects net amount calculation.
  isSplitPayment       Boolean @default(false) @map("is_split_payment")
  /// VAT deductibility percentage on purchases (e.g. 40% for company vehicles).
  deductibilityPercent Decimal @default(100) @map("deductibility_percent") @db.Decimal(5, 2)
  /// If false, input VAT is not deductible (e.g. entertainment expenses).
  vatDeductible        Boolean @default(true) @map("vat_deductible")

  // === TEMPORAL VALIDITY ===

  validFrom DateTime  @default(now()) @map("valid_from")
  /// NULL = rule still in force.
  validTo   DateTime? @map("valid_to")

  // === STATUS AND PRESENTATION ===

  active       Boolean @default(true)
  /// If true, this rule is pre-selected as default within the scope defined by customerType/applicableFor.
  isDefault    Boolean @default(false) @map("is_default")
  displayOrder Int     @default(0) @map("display_order")
  /// Optional HEX color to visually distinguish the rule in UI (#RRGGBB).
  color        String? @db.VarChar(7)

  // === RELATIONS ===

  translations     TaxRuleTranslation[]
  customers        Customer[]           @relation("CustomerTaxRule")
  suppliers        Supplier[]           @relation("SupplierTaxRule")
  tenantsSales     Tenant[]             @relation("TenantDefaultSalesTaxRule")
  tenantsPurchases Tenant[]             @relation("TenantDefaultPurchasesTaxRule")
  priceListItems   PriceListItem[]      @relation("PriceListTaxRule")
  documentLines    DocumentLine[]       @relation("DocumentLineTaxRule")
  products         Product[]            @relation("ProductTaxRule")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@unique([code], where: { tenantId: null }, map: "unique_global_tax_rule_code")
  @@index([rate])
  @@index([vatNatureId])
  @@index([countryCode])
  @@index([active, isDefault])
  @@index([validFrom, validTo])
  @@index([applicableFor])
  @@index([tenantId])
  @@index([tenantId, active, isDefault]) // compound index for frequent lookup
  @@map("tax_rules")
}

/// Localized translations of TaxRule (name + description per active language).
model TaxRuleTranslation {
  id        Int     @id @default(autoincrement())
  taxRuleId Int     @map("tax_rule_id")
  taxRule   TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  name        String  @db.VarChar(255)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([taxRuleId, languageId])
  @@index([languageId])
  @@map("tax_rule_translations")
}

/// Standard or tenant-custom withholding tax type.
/// Global records (tenantId NULL) map to Italian FatturaPA RT codes.
/// Tenants can define additional types for edge cases.
model WithholdingTaxType {
  id String @id @default(cuid())

  /// FatturaPA code (e.g. RT01, RT02). Unique per scope.
  code String @db.VarChar(10)

  /// Percentage base: what fraction of the gross amount is subject to withholding.
  /// e.g. 100.00 for lavoro autonomo, 50.00 for agenti (ritenuta su 50% del compenso).
  taxableBasePercent Decimal @map("taxable_base_percent") @db.Decimal(5, 2)

  /// Withholding rate applied to the taxable base (e.g. 20.00, 23.00).
  rate Decimal @db.Decimal(5, 2)

  active Boolean @default(true)

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantWithholdingTaxTypes", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  documents Document[]
  suppliers Supplier[] @relation("SupplierDefaultWithholdingTaxType")
  withholdingTaxSettlementLines WithholdingTaxSettlementLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@unique([code], where: { tenantId: null }, map: "unique_global_withholding_tax_type_code")
  @@map("withholding_tax_types")
}

// ============================================================================
// SOCIAL SECURITY FUND (Cassa Previdenziale — FatturaPA TC01–TC22)
// ============================================================================

/// FatturaPA social security fund master data (TC01–TC22).
/// Global shared table — no tenantId (same rationale as WithholdingTaxType).
/// Seeded from the official Agenzia delle Entrate code list; never modified by tenants.
model SocialSecurityFund {
    id String @id @default(cuid())

    /// FatturaPA code (e.g. "TC02", "TC07"). Unique, used as natural key in XML generation.
    code String @unique @db.VarChar(4)

    /// Official Italian description (e.g. "INPS", "ENPAM").
    description String @db.VarChar(255)

    /// Standard contribution rate as defined by the fund (e.g. 4.00 for Enasarco).
    /// NULL if the rate is variable or depends on the contract type.
    defaultRate Decimal? @map("default_rate") @db.Decimal(5, 2)

    /// If true, this fund adds to the taxable base (imponibile) rather than being deducted.
    /// e.g. Enasarco increases the taxable amount; ritenuta decreases it.
    addsTaxableBase Boolean @default(false) @map("adds_taxable_base")

    active Boolean @default(true)

    suppliers Supplier[]

    @@map("social_security_funds")
}

// ============================================================================
// WITHHOLDING TAX SETTLEMENT (Liquidazione Ritenute — Versamento F24)
// ============================================================================

/// Aggregates withholding tax liabilities accrued across multiple supplier invoices
/// into a single periodic F24 payment (typically monthly).
/// The accrual entries (Debito Erario c/Ritenute) are created at SUPPLIER_INVOICE
/// registration — this model tracks only the settlement event.
model WithholdingTaxSettlement {
    id       String @id @default(cuid())
    tenantId String @map("tenant_id")
    tenant   Tenant @relation("TenantWithholdingTaxSettlements", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

    // === PERIOD ===

    /// Calendar month this settlement covers (1–12).
    periodMonth Int @map("period_month")
    /// Calendar year this settlement covers.
    periodYear  Int @map("period_year")

    // === F24 PAYMENT ===

    /// Date the F24 was submitted / bank debit executed.
    paymentDate DateTime @map("payment_date")
    /// F24 section code (e.g. "1040" for ritenute lavoro autonomo).
    f24TaxCode  String   @map("f24_tax_code") @db.VarChar(10)
    /// Total amount remitted to Agenzia delle Entrate.
    totalAmount Decimal  @map("total_amount") @db.Decimal(15, 2)

    /// Bank account used for F24 payment.
    bankAccountId String?      @map("bank_account_id")
    bankAccount   BankAccount? @relation("SettlementBankAccount", fields: [bankAccountId], references: [id], onDelete: SetNull)

    /// External reference (CRO, F24 protocol, or payment provider ID).
    paymentReference String? @map("payment_reference") @db.VarChar(100)

    // === STATUS ===

    status WithholdingTaxSettlementStatus @default(DRAFT)

    /// User who approved and submitted the F24.
    submittedByUserId String? @map("submitted_by_user_id")
    submittedBy       User?   @relation("SettlementSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
    submittedAt       DateTime? @map("submitted_at")

    notes String? @db.Text

    // === RELATIONS ===

    /// Individual withholding tax lines aggregated into this settlement.
    lines          WithholdingTaxSettlementLine[]
    journalEntries JournalEntry[]                 @relation("SettlementJournalEntries")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    /// One settlement per period per tenant (one F24 per month).
    @@unique([tenantId, periodYear, periodMonth])
    @@index([tenantId, status])
    @@index([tenantId, paymentDate])
    @@map("withholding_tax_settlements")
}

enum WithholdingTaxSettlementStatus {
    DRAFT      // Being compiled; lines still being added
    LOCKED     // Finalized; ready for F24 submission
    SUBMITTED  // F24 submitted to Agenzia delle Entrate
    PAID       // Bank debit confirmed
}

/// Single withholding tax line linking a supplier invoice to a settlement.
/// One line per SUPPLIER_INVOICE that carried a withholding tax accrual.
model WithholdingTaxSettlementLine {
    id           String                   @id @default(cuid())
    settlementId String                   @map("settlement_id")
    settlement   WithholdingTaxSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

    /// Source invoice that generated the withholding tax accrual.
    documentId String   @map("document_id")
    document   Document @relation("DocumentWithholdingLines", fields: [documentId], references: [id], onDelete: Restrict)

    supplierId String   @map("supplier_id")
    supplier   Supplier @relation("SupplierWithholdingLines", fields: [supplierId], references: [id], onDelete: Restrict)

    withholdingTaxTypeId String             @map("withholding_tax_type_id")
    withholdingTaxType   WithholdingTaxType @relation(fields: [withholdingTaxTypeId], references: [id], onDelete: Restrict)

    /// Taxable base amount from the source invoice.
    taxableBase       Decimal @map("taxable_base") @db.Decimal(15, 2)
    /// Applied withholding rate (snapshotted from invoice).
    withholdingPercent Decimal @map("withholding_percent") @db.Decimal(5, 2)
    /// Withholding amount to remit (snapshotted from Document.withholdingTaxAmount).
    withholdingAmount  Decimal @map("withholding_amount") @db.Decimal(15, 2)

    /// Invoice registration date — determines which F24 period this line belongs to.
    documentRegistrationDate DateTime @map("document_registration_date")

    createdAt DateTime @default(now()) @map("created_at")

    /// Each invoice can appear in at most one settlement.
    @@unique([documentId])
    @@index([settlementId])
    @@index([supplierId])
    @@map("withholding_tax_settlement_lines")
}