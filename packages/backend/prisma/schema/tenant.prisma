// ============================================================================
// TENANT — Identità operativa di chi usa il sistema (emittente documenti)
// Tenant è l'entità SaaS che possiede dati e sequenze numeriche.
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// Italian SdI regime codes — defined by Agenzia delle Entrate, not user-configurable.
// Stamped on every electronic invoice as <RegimeFiscale>.
enum TaxRegime {
  RF01 // Ordinario
  RF02 // Contribuenti minimi (ex art. 27, DL 98/2011)
  RF04 // Agricoltura / attività connesse
  RF05 // Vendita sali e tabacchi
  RF06 // Commercio fiammiferi
  RF07 // Editoria
  RF08 // Gestione servizi telefonia pubblica
  RF09 // Rivendita documenti di trasporto pubblico
  RF10 // Intrattenimenti / giochi / altre attività
  RF11 // Agenzie viaggi e turismo
  RF12 // Agriturismo
  RF13 // Vendite a domicilio
  RF14 // Rivenditore beni usati / oggetti arte
  RF15 // Agenzie vendite all'asta
  RF16 // IVA per cassa (art. 32-bis DL 83/2012)
  RF17 // IVA per cassa (art. 6, comma 5, DPR 633/1972)
  RF18 // Altro
  RF19 // Regime forfettario (L. 190/2014)
}

/// SaaS tenant — top-level isolation boundary for all operational data.
model Tenant {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(20) // slug univoco, es. "acme-srl"

  status TenantStatus @default(ACTIVE)
  plan   TenantPlan   @default(FREE)

  // Azienda legale emittente — NON nullable: senza Company non si emettono documenti
  companyId String  @unique @map("company_id")
  company   Company @relation("TenantOwnedCompany", fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // === REGIME FISCALE ===
  taxRegime TaxRegime @default(RF01) @map("tax_regime") // es. "RF01" (ordinario), "RF19" (forfettario)

  defaultSalesTaxRuleId Int?     @map("default_sales_tax_rule_id")
  defaultSalesTaxRule   TaxRule? @relation("TenantDefaultSalesTaxRule", fields: [defaultSalesTaxRuleId], references: [id])

  defaultPurchasesTaxRuleId Int?     @map("default_purchases_tax_rule_id")
  defaultPurchasesTaxRule   TaxRule? @relation("TenantDefaultPurchasesTaxRule", fields: [defaultPurchasesTaxRuleId], references: [id])

  // === CONFIGURAZIONI GENERALI ===
  defaultCurrencyCode String    @default("EUR") @map("default_currency_code") @db.Char(3)
  defaultCurrency     Currency  @relation("TenantCurrency", fields: [defaultCurrencyCode], references: [code])
  defaultLanguageId   Int?      @map("default_language_id") // es. "it"
  defaultLanguage     Language? @relation(fields: [defaultLanguageId], references: [id])

  // === FATTURAZIONE ELETTRONICA SdI ===
  sdiTransmissionFormat String? @map("sdi_transmission_format") @db.VarChar(10) // es. "FPR12" (privati), "FPA12" (PA)
  sdiCertificateRef     String? @map("sdi_certificate_ref") @db.VarChar(500) // S3 key or absolute path

  // === RELAZIONI OPERATIVE ===
  memberships              UserTenantMembership[] @relation("TenantUsers")
  documents                Document[]             @relation("TenantDocuments")
  documentSequences        DocumentSequence[]     @relation("TenantSequences")
  taxRules                 TaxRule[]              @relation("TenantOwnedTaxRules")
  companies                Company[]              @relation("TenantCompanies")
  categories               Category[]             @relation("TenantCategories")
  products                 Product[]              @relation("TenantProducts")
  productVariants          ProductVariant[]       @relation("TenantProductVariants")
  manufacturers            Manufacturer[]         @relation("TenantManufacturers")
  roles                    Role[]                 @relation("TenantRoles")
  priceLists               PriceList[]            @relation("TenantPriceLists")
  paymentMethods           PaymentMethod[]        @relation("TenantPaymentMethods")
  bankAccounts             TenantBankAccount[]    @relation("TenantBankAccounts")
  leads                    Lead[]                 @relation("TenantLeads")
  opportunities            Opportunity[]          @relation("TenantOpportunities")
  opportunityClosedReasons ClosedReason[]         @relation("TenantOpportunityClosedReasons")
  intrastatTransactions    IntrastatTransaction[] @relation("TenantIntrastatTransactions")
  activities               Activity[]             @relation("TenantActivities")
  activityTemplates        ActivityTemplate[]     @relation("TenantActivityTemplates")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([plan])
  @@map("tenants")
}

/// Tenant-owned bank account used for payment receipt or disbursement.
model TenantBankAccount {
  id       Int    @id @default(autoincrement())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation("TenantBankAccounts", fields: [tenantId], references: [id], onDelete: Cascade)

  /// Internal label (e.g. "Conto principale EUR", "Conto USD estero").
  name         String   @db.VarChar(100)
  bankName     String   @map("bank_name") @db.VarChar(100)
  iban         String   @db.VarChar(34)
  bic          String?  @db.VarChar(11)
  /// ISO 4217 currency code of the account.
  currencyCode String   @default("EUR") @map("currency_code") @db.Char(3)
  currency     Currency @relation("BankAccountCurrency", fields: [currencyCode], references: [code])

  active    Boolean @default(true)
  isDefault Boolean @default(false) @map("is_default")

  // === RELATIONS ===
  paymentMethods PaymentMethod[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, iban])
  @@index([tenantId, active])
  @@map("tenant_bank_accounts")
}
