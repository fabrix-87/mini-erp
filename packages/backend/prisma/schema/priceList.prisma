// Tipo di listino
enum PriceListType {
    SALE // Listino di vendita (standard)
    PURCHASE // Listino di acquisto (dai fornitori)
    PROMOTION // Listino promozionale (sovrascrive temporaneamente)
    CONTRACT // Listino specifico per contratto cliente
}

// Strategia di calcolo (se il listino è derivato da un altro)
enum PriceListStrategy {
    EXPLICIT // I prezzi sono inseriti manualmente riga per riga
    PERCENT_DECREASE // Sconto percentuale dal listino padre (es. -20%)
    PERCENT_INCREASE // Ricarico percentuale dal listino padre
    FIXED_DECREASE // Sconto fisso (es. -5€)
    FIXED_INCREASE // Ricarico fisso
}

model PriceList {
    id Int @id @default(autoincrement())

    // Identificazione
    code     String @unique @db.VarChar(50) // Es. LIST_PUB, LIST_GOLD
    name     String @db.VarChar(100)
    currency String @default("EUR") @db.Char(3)

    type PriceListType @default(SALE)

    // Validità (opzionale, se null vale sempre)
    validFrom DateTime?
    validTo   DateTime?
    active    Boolean   @default(true)

    // LOGICA EREDITARIETA' (Listini dinamici)
    // Se parentListId è presente, questo listino calcola i prezzi basandosi sul padre
    parentListId  Int?
    parentList    PriceList?  @relation("PriceListHierarchy", fields: [parentListId], references: [id])
    childrenLists PriceList[] @relation("PriceListHierarchy")

    strategy       PriceListStrategy @default(EXPLICIT)
    strategyValue  Decimal           @default(0) @db.Decimal(10, 2) // Es. 10.00 (per indicare 10%)
    roundingMethod String?           @default("none") @db.VarChar(20) // none, nearest_05, nearest_10, up, down

    // Relazioni
    items     PriceListItem[]
    customers Customer[] // Clienti assegnati a questo listino

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([active])
    @@index([validFrom, validTo])
}

model PriceListItem {
    id Int @id @default(autoincrement())

    priceListId Int
    priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

    // Collegamento Variante Prodotto
    variantId Int
    variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

    // Scaglioni di quantità (Quantity Breaks)
    // Default 1. Se inserisci una riga con minQuantity 10, si applica da 10 pezzi in su.
    minQuantity Int @default(1)

    // Il Prezzo
    price Decimal @db.Decimal(19, 4) // 4 decimali per precisione unitaria

    // Opzionale: Sconto specifico per questa riga (sovrascrive logiche generali)
    discountPercent Decimal? @db.Decimal(5, 2)

    // Date specifiche per la riga (es. offerta lampo su un solo prodotto)
    validFrom DateTime?
    validTo   DateTime?

    // Relazioni
    taxRuleId Int?
    taxRule   TaxRule? @relation("PriceListTaxRule", fields: [taxRuleId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Vincoli: Non puoi avere due prezzi per lo stesso prodotto/variante/quantità nello stesso listino
    @@unique([priceListId, variantId, minQuantity])
    @@index([variantId])
}
