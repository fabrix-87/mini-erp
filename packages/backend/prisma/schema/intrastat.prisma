enum IntrastatFlow {
  ARRIVAL // Arrivo di beni/servizi (Acquisti)
  DISPATCH // Spedizione di beni/servizi (Vendite)
}

model IntrastatTransaction {
  id              Int       @id @default(autoincrement())

  // Collegamento al documento e alla riga
  documentId      Int
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  documentLineId  Int
  documentLine    DocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Cascade)

  flow            IntrastatFlow // ARRIVAL o DISPATCH

  // Dati Transazionali (Snapshot)
  transactionDate DateTime  // Data della transazione (solitamente la data DDT/Fattura)
  
  // Codici (FK)
  transactionCode String    @db.Char(2)
  transCodeRel    IntrastatTransactionCode @relation(fields: [transactionCode], references: [code])
  
  // Nomenclatura (FK)
  commodityCode   String    @db.Char(8)
  commCodeRel     IntrastatCommodityCode @relation(fields: [commodityCode], references: [code])
  
  // Dati Nazione (Snapshot dal Documento)
  partnerCountryCode String @db.Char(2) // Nazione del partner (es. FR)
  
  // Dati Monetari
  invoicedValue   Decimal   @db.Decimal(15, 2) // Valore Fatturato (imponibile riga)
  statisticalValue Decimal @db.Decimal(15, 2) // Valore Statistico (incl. costi accessori)

  // Dati Logistici
  netMass         Decimal   @db.Decimal(15, 3) // Peso netto in Kg
  supplementaryUnits Int?   // Unità supplementare (es. litri, metri)
  
  modeOfTransport String?   @db.VarChar(2) // Codice modalità di trasporto (es. 1, 2, 3...)
  
  // Dati Correzioni
  isCorrection    Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([documentLineId]) // Una riga di documento ha una sola transazione Intrastat
  @@index([transactionDate])
  @@index([partnerCountryCode])
}

model IntrastatTransactionCode {
  code          String    @id @db.Char(2) // Es. 11 (Acquisto/Vendita)
  descriptionIT String    @db.VarChar(255)
  descriptionEN String    @db.VarChar(255)
  
  // Relazioni inverse
  transactions  IntrastatTransaction[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model IntrastatCommodityCode {
  code          String    @id @db.Char(8) // Codice NC8 (es. 85171200)
  descriptionIT String    @db.VarChar(500)
  descriptionEN String    @db.VarChar(500)
  
  // Opzionale: Link a Product/Variant (può essere un'unica relazione nel modello ProductVariant)
  productVariants ProductVariant[]

  // Relazioni inverse
  transactions  IntrastatTransaction[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}