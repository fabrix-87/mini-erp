// ============================================================================
// INTRASTAT COMPLIANCE SYSTEM
// European Union customs tracking for cross-border trade declaration.
// Uses strict snapshotting to ensure historical financial and regulatory audits.
// ============================================================================

enum IntrastatFlow {
  ARRIVAL
  DISPATCH
}

/// Regulatory ledger recording transactions subject to EU Intrastat customs reporting.
model IntrastatTransaction {
  id String @id @default(cuid())

  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  documentLineId String       @map("document_line_id")
  documentLine   DocumentLine @relation(fields: [documentLineId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation("TenantIntrastatTransactions", fields: [tenantId], references: [id], onDelete: Restrict)

  flow IntrastatFlow

  /// Business-effective timestamp driving the tax declaration period.
  transactionDate DateTime @map("transaction_date")

  transactionCode String                   @map("transaction_code") @db.Char(2)
  transCodeRel    IntrastatTransactionCode @relation(fields: [transactionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  commodityCode String                 @map("commodity_code") @db.Char(8)
  commCodeRel   IntrastatCommodityCode @relation(fields: [commodityCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  /// ISO 3166-1 alpha-2 country reference. Immutable audit snapshot from document partner data.
  partnerCountryCode String  @map("partner_country_code") @db.Char(2)
  partnerCountry     Country @relation("IntrastatPartnerCountry", fields: [partnerCountryCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  /// Net transactional value. Immutable snapshot of line taxable amount.
  invoicedValue Decimal @map("invoiced_value") @db.Decimal(15, 2)

  /// Statistical value computed for customs (invoicedValue adjusted with ancillary costs).
  statisticalValue Decimal @map("statistical_value") @db.Decimal(15, 2)

  netMass Decimal @map("net_mass") @db.Decimal(15, 3)

  /// Non-mass customs quantity constraint (e.g., liters, units) required by specific NC8 codes.
  supplementaryUnits Int? @map("supplementary_units")

  /// Transport mode code (1–2 chars). Single digit per EU standard; 2-digit used by some member states.
  modeOfTransportCode String?                 @map("mode_of_transport_code") @db.Char(2)
  modeOfTransport     IntrastatTransportMode? @relation(fields: [modeOfTransportCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  /// Monotonically increasing amendment counter for this line's Intrastat record.
  /// 0 = original declaration; 1+ = successive corrections.
  /// Prevents duplicate correction entries while allowing multi-round amendments.
  /// NOTE: correctionSequence must be incremented atomically by the application
  /// (SELECT MAX(correctionSequence) FOR UPDATE) before inserting a new correction row.
  correctionSequence Int @default(0) @map("correction_sequence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Guarantees at most one record per (line, correction round).
  /// correctionSequence 0 = original; increment on each amendment cycle.
  @@unique([documentLineId, correctionSequence])
  @@index([tenantId, partnerCountryCode])
  @@index([tenantId])
  @@index([tenantId, flow]) // ARRIVAL vs DISPATCH split
  @@index([tenantId, transactionDate]) // range temporale per periodo dichiarativo
  @@index([transactionDate])
  @@index([partnerCountryCode])
  @@map("intrastat_transactions")
}

// ============================================================================
// INTRASTAT COMPLIANCE SYSTEM (REGULATORY MASTER DATA)
// Normalized multi-language dictionaries for EU customs reporting.
// ============================================================================

/// Nature of Transaction (NoT) regulatory master catalog (e.g., "11", "12").
model IntrastatTransactionCode {
  code String @id @db.Char(2)

  translations IntrastatTransactionCodeTranslation[]
  transactions IntrastatTransaction[]

  active    Boolean   @default(true)
  /// Start of validity period. Aligns with EU annual CN8 update cycles (typically Jan 1).
  validFrom DateTime  @default(now()) @map("valid_from")
  /// End of validity. NULL = currently valid.
  validTo   DateTime? @map("valid_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([validFrom, validTo])
  @@map("intrastat_transaction_codes")
}

/// Localization ledger for Intrastat Transaction Codes.
model IntrastatTransactionCodeTranslation {
  id Int @id @default(autoincrement())

  transactionCode String                   @map("transaction_code") @db.Char(2)
  transactionRel  IntrastatTransactionCode @relation(fields: [transactionCode], references: [code], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  /// Localized official customs description for the transaction type.
  description String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([transactionCode, languageId])
  @@index([languageId])
  @@map("intrastat_transaction_code_translations")
}

/// Combined Nomenclature (NC8) 8-digit master catalog for customs tariff classification.
model IntrastatCommodityCode {
  code String @id @db.Char(8)

  translations IntrastatCommodityCodeTranslation[]
  products     Product[]
  transactions IntrastatTransaction[]

  active    Boolean   @default(true)
  /// Start of validity period. Aligns with EU annual CN8 update cycles (typically Jan 1).
  validFrom DateTime  @default(now()) @map("valid_from")
  /// End of validity. NULL = currently valid.
  validTo   DateTime? @map("valid_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([validFrom, validTo])
  @@map("intrastat_commodity_codes")
}

/// Localization ledger for Combined Nomenclature (NC8) descriptions.
model IntrastatCommodityCodeTranslation {
  id Int @id @default(autoincrement())

  commodityCode String                 @map("commodity_code") @db.Char(8)
  commodityRel  IntrastatCommodityCode @relation(fields: [commodityCode], references: [code], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  /// Localized official customs description for the goods category.
  description String @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([commodityCode, languageId])
  @@index([languageId])
  @@map("intrastat_commodity_code_translations")
}

/// EU Intrastat transport mode master catalog.
model IntrastatTransportMode {
  code String @id @db.Char(2)

  active    Boolean   @default(true)
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  translations IntrastatTransportModeTranslation[]
  transactions IntrastatTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("intrastat_transport_modes")
}

/// Localized descriptions for Intrastat transport mode codes.
model IntrastatTransportModeTranslation {
  id Int @id @default(autoincrement())

  transportModeCode String                 @map("transport_mode_code") @db.Char(2)
  transportMode     IntrastatTransportMode @relation(fields: [transportModeCode], references: [code], onDelete: Cascade)

  languageId Int      @map("language_id")
  language   Language @relation(fields: [languageId], references: [id])

  /// Localized official label (e.g. "Marittimo", "Maritime").
  description String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([transportModeCode, languageId])
  @@index([languageId])
  @@map("intrastat_transport_mode_translations")
}
