// ============================================================================
// LEAD MANAGEMENT
// ============================================================================

/// Lead funnel status.
enum LeadStatus {
  NEW // New lead, not yet contacted
  CONTACTED // First contact made
  QUALIFIED // Qualified and ready for opportunity creation
  UNQUALIFIED // Not a valid target
  NURTURING // In nurturing/cultivation phase
  CONVERTED // Converted to Customer
  LOST // Lost or not interested
  DUPLICATE // Duplicate of another lead
  ARCHIVED // Archived
}

/// Acquisition channel that originated the lead.
enum LeadSource {
  WEBSITE // Website (contact form, landing page)
  REFERRAL // Word of mouth / customer referral
  SOCIAL_MEDIA // Social media (LinkedIn, Facebook, etc.)
  EMAIL_CAMPAIGN // Email marketing campaign
  PHONE_CALL // Inbound phone call
  COLD_CALL // Outbound cold call
  EVENT // Event / trade show / webinar
  PARTNER // Commercial partner
  ADVERTISING // Online advertising (Google Ads, Facebook Ads)
  CONTENT // Content marketing (blog, ebook, whitepaper)
  DIRECT // Direct contact
  CHAT // Website chat
  OTHER // Other
}

/// Conversion likelihood of the lead.
enum LeadQuality {
  HOT // High conversion probability
  WARM // Medium conversion probability
  COLD // Low conversion probability
}

/// Expected timeframe for the purchase decision.
enum LeadPurchaseTimeframe {
  IMMEDIATE // Less than 1 month
  SHORT_TERM // 1–3 months
  MEDIUM_TERM // 3–6 months
  LONG_TERM // 6–12 months
  UNDEFINED // Not yet determined
}

/// Role of the primary contact in the decision-making process.
enum LeadDecisionAuthority {
  DECISION_MAKER
  INFLUENCER
  GATEKEEPER
  END_USER
  UNKNOWN
}

/// Prospective company record in the sales funnel.
/// Tenant-scoped. Convertible to Customer via the convertedTo relation.
/// Tracks qualification, BANT, GDPR consent, UTM attribution, and activity history.
model Lead {
  id Int @id @default(autoincrement())

  // Unique human-readable code per tenant (e.g. LEAD-2026-0001)
  code String @db.VarChar(20)

  // === COMPANY DATA ===

  companyName String  @map("company_name") @db.VarChar(255)
  /// Trade name if different from the legal company name.
  tradeName   String? @map("trade_name") @db.VarChar(255)
  website     String? @db.VarChar(255)

  // Fiscal data — optional at lead stage, required upon conversion to Customer
  vatNumber String? @map("vat_number") @db.VarChar(20) // VAT number
  taxCode   String? @map("tax_code") @db.VarChar(20) // Tax code / fiscal code

  countryCode String  @default("IT") @map("country_code") @db.Char(2)
  country     Country @relation("LeadCountry", fields: [countryCode], references: [code])

  /// Tenant that owns this lead. All lead data is tenant-isolated.
  tenantId Int    @map("tenant_id")
  tenant   Tenant @relation("TenantLeads", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // === PRIMARY CONTACT ===

  contactFirstName  String  @map("contact_first_name") @db.VarChar(100)
  contactLastName   String  @map("contact_last_name") @db.VarChar(100)
  contactEmail      String  @map("contact_email") @db.VarChar(255)
  contactPhone      String? @map("contact_phone") @db.VarChar(50)
  contactMobile     String? @map("contact_mobile") @db.VarChar(50)
  /// Contact's job title (e.g. CEO, Procurement Manager).
  contactPosition   String? @map("contact_position") @db.VarChar(100)
  /// Contact's department (e.g. IT, Marketing, Procurement).
  contactDepartment String? @map("contact_department") @db.VarChar(100)

  // === ADDRESS (simplified — expanded upon conversion) ===

  address      String? @db.VarChar(255)
  city         String? @db.VarChar(100)
  /// Province code (e.g. MI, RM) — Italian standard.
  provinceCode String? @map("province_code") @db.Char(2)
  zipCode      String? @map("zip_code") @db.VarChar(20)

  // === LEAD MANAGEMENT ===

  status  LeadStatus  @default(NEW)
  source  LeadSource  @default(OTHER)
  quality LeadQuality @default(COLD)

  /// Lead scoring value (0–100). Computed from engagement, demographic fit, and behavioral signals.
  score Int @default(0) @db.SmallInt

  // === COMMERCIAL QUALIFICATION ===

  /// Estimated potential opportunity value.
  estimatedValue Decimal?      @map("estimated_value") @db.Decimal(15, 2)
  /// Estimated company size category.
  estimatedSize  CustomerSize? @map("estimated_size")
  /// Industry or sector (e.g. Manufacturing, Retail, IT).
  industry       String?       @db.VarChar(100)
  /// Estimated number of employees.
  employeesCount Int?          @map("employees_count")
  /// Estimated annual revenue.
  annualRevenue  Decimal?      @map("annual_revenue") @db.Decimal(15, 2)
  /// Available budget declared by the lead.
  budget         Decimal?      @db.Decimal(15, 2)

  purchaseTimeframe LeadPurchaseTimeframe? @map("purchase_timeframe")
  decisionAuthority LeadDecisionAuthority? @map("decision_authority")

  /// Primary need or pain point expressed by the lead.
  primaryNeed  String? @map("primary_need") @db.Text
  /// Products or services the lead has shown interest in.
  interestedIn String? @map("interested_in") @db.Text

  // === TRACKING AND CONVERSION ===

  createdByUserId String? @map("created_by_user_id")
  createdBy       User?   @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Sales owner assigned to this lead.
  assignedUserId String? @map("assigned_user_id")
  assignedUser   User?   @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Timestamp of conversion to Customer.
  convertedAt   DateTime? @map("converted_at")
  /// Reference to the Customer record created upon conversion.
  convertedToId String?   @unique @map("converted_to_id")
  convertedTo   Customer? @relation("ConvertedCustomer", fields: [convertedToId], references: [id])

  convertedByUserId String? @map("converted_by_user_id")
  convertedBy       User?   @relation("LeadConvertedBy", fields: [convertedByUserId], references: [id])

  // === LOSS TRACKING ===

  /// Reason for loss. Populated when status = LOST.
  lostReason String?   @map("lost_reason") @db.Text
  lostDate   DateTime? @map("lost_date")

  // === ACTIVITY TRACKING ===

  firstContactDate DateTime? @map("first_contact_date")
  lastContactDate  DateTime? @map("last_contact_date")
  /// Number of contact attempts made (calls, emails, etc.).
  contactAttempts  Int       @default(0) @map("contact_attempts")
  /// Timestamp of the last status transition. NULL = status never changed.
  lastStatusChange DateTime? @map("last_status_change")

  // === BANT QUALIFICATION (Budget, Authority, Need, Timeframe) ===

  bantQualified Boolean @default(false) @map("bant_qualified")
  bantNotes     String? @map("bant_notes") @db.Text

  // === GDPR AND CONSENT ===

  privacyConsent       Boolean   @default(false) @map("privacy_consent")
  privacyConsentDate   DateTime? @map("privacy_consent_date")
  marketingConsent     Boolean   @default(false) @map("marketing_consent")
  marketingConsentDate DateTime? @map("marketing_consent_date")
  /// If true, this contact must not be reached by phone.
  doNotCall            Boolean   @default(false) @map("do_not_call")
  /// If true, this contact must not be reached by email.
  doNotEmail           Boolean   @default(false) @map("do_not_email")

  // === UTM ATTRIBUTION ===

  /// Origin campaign name (e.g. "Summer Campaign 2026", "Webinar AI").
  campaignName String? @map("campaign_name") @db.VarChar(100)
  /// UTM medium (e.g. cpc, organic, social).
  utmMedium    String? @map("utm_medium") @db.VarChar(50)
  /// UTM source (e.g. google, facebook, linkedin).
  utmSource    String? @map("utm_source") @db.VarChar(50)
  /// UTM campaign slug (e.g. spring_sale).
  utmCampaign  String? @map("utm_campaign") @db.VarChar(50)
  /// Landing page URL where the lead originated.
  landingPage  String? @map("landing_page") @db.VarChar(255)
  referrer     String? @db.VarChar(255)

  // === NOTES AND CUSTOM FIELDS ===

  notes        String? @db.Text
  description  String? @db.Text
  customFields Json?   @map("custom_fields")
  /// Competitors the lead is currently evaluating.
  competitors  String? @db.Text

  // === RELATIONS ===

  /// Activities linked to this lead (calls, emails, meetings).
  activities    Activity[]
  /// Documents attached to this lead (presentations, quotes, contracts).
  documents     Document[]
  /// Opportunities generated from this lead.
  opportunities Opportunity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([source])
  @@index([contactEmail])
  @@index([convertedToId])
  @@index([createdAt])
  @@index([lastContactDate])
  @@index([status, assignedUserId]) // Compound: "my active leads" queries
  @@index([quality, score]) // Compound: lead prioritization
  @@map("leads")
}
