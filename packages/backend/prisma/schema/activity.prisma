// ============================================================================
// ACTIVITIES (CRM)
// ============================================================================

enum ActivityType {
  CALL // Phone call
  EMAIL // Email
  MEETING // Meeting / appointment
  TASK // Task / to-do
  NOTE // Note / memo
  WHATSAPP // WhatsApp message
  SMS // SMS
  VIDEO_CALL // Video call
  SITE_VISIT // On-site visit
  OTHER // Other
}

enum ActivityStatus {
  SCHEDULED // Planned future activity
  IN_PROGRESS // Currently in progress
  COMPLETED // Successfully completed
  CANCELLED // Cancelled before execution
  RESCHEDULED // Rescheduled to a new date/time
  NO_SHOW // Participant did not show up
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityOutcome {
  SUCCESSFUL // Activity completed successfully
  NO_ANSWER // No response from the contact
  LEFT_MESSAGE // Left a voicemail or written message
  FOLLOW_UP_NEEDED // Requires a follow-up activity
  NOT_INTERESTED // Contact is not interested
  WRONG_CONTACT // Reached the wrong person
  CALLBACK_LATER // Contact asked to be called back
  POSTPONED // Activity postponed by agreement
  OTHER
}

/// Participation status for a meeting participant.
enum ParticipantStatus {
  INVITED // Invited, no response yet
  ACCEPTED // Accepted the invitation
  DECLINED // Declined the invitation
  TENTATIVE // Accepted tentatively
  ATTENDED // Actually attended
  NO_SHOW // Did not attend
}

/// Role of a participant within a meeting.
enum ParticipantRole {
  ORGANIZER // Meeting organizer
  REQUIRED // Required participant
  OPTIONAL // Optional participant
}

/// CRM activity record (call, email, meeting, task, note, etc.).
/// Tenant-scoped: tenantId is mandatory on every Activity row.
/// At least one of companyId / customerId / contactId / opportunityId / leadId
/// should be set to anchor the activity to a business entity.
model Activity {
  id String @id @default(cuid())

  /// Tenant that owns this activity — mandatory for multi-tenant isolation.
  tenantId String @map("tenant_id")
  tenant   Tenant @relation("TenantActivities", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // --- Type / status ---

  type     ActivityType
  status   ActivityStatus   @default(SCHEDULED)
  priority ActivityPriority @default(MEDIUM)
  outcome  ActivityOutcome?

  // --- Core fields ---

  subject     String  @db.VarChar(255)
  description String? @db.Text
  /// Physical location or meeting link (e.g. Google Meet URL).
  location    String? @db.VarChar(255)

  // --- Scheduling ---

  scheduledStart DateTime  @map("scheduled_start")
  scheduledEnd   DateTime? @map("scheduled_end")
  actualStart    DateTime? @map("actual_start")
  actualEnd      DateTime? @map("actual_end")
  /// Duration in minutes — redundant when both actualStart/End are set; kept for quick reads.
  duration       Int?

  // --- Reminder ---

  /// Minutes before scheduledStart to send the reminder (e.g. 15, 30, 60).
  reminderMinutes Int?    @map("reminder_minutes")
  reminderSent    Boolean @default(false) @map("reminder_sent")

  // --- Business entity relations ---
  // At least one should be populated. onDelete policy:
  //   Cascade  → activity has no standalone meaning without the parent
  //   SetNull  → activity keeps its history even if the related record is removed

  companyId String?
  company   Company? @relation("CompanyActivities", fields: [companyId], references: [id], onDelete: SetNull)

  customerId String?   @map("customer_id")
  customer   Customer? @relation("CustomerActivities", fields: [customerId], references: [id], onDelete: SetNull)

  contactId String?  @map("contact_id")
  contact   Contact? @relation("ContactActivities", fields: [contactId], references: [id], onDelete: SetNull)

  opportunityId String?      @map("opportunity_id")
  opportunity   Opportunity? @relation("OpportunityActivities", fields: [opportunityId], references: [id], onDelete: SetNull)

  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // --- Users ---

  /// User responsible for executing this activity.
  assignedUserId String @map("assigned_user_id")
  assignedUser   User   @relation("ActivityAssigned", fields: [assignedUserId], references: [id])

  /// User who created this activity record.
  createdByUserId String @map("created_by_user_id")
  createdBy       User   @relation("ActivityCreated", fields: [createdByUserId], references: [id])

  // --- Participants (for MEETING / VIDEO_CALL types) ---

  participants ActivityParticipant[]

  // --- Attachments ---
  /// Structured list of file references: [{ name, url, mimeType, sizeBytes }].
  /// Enforce shape with a Zod schema at the application layer.
  attachments Json? @db.JsonB

  // --- Notes and result ---

  internalNotes String? @map("internal_notes") @db.Text
  result        String? @db.Text

  // --- Follow-up self-relation ---
  // followUpActivityId references the *original* activity this one follows up on.

  followUpActivityId String?    @map("follow_up_activity_id")
  followUpActivity   Activity?  @relation("ActivityFollowUp", fields: [followUpActivityId], references: [id], onDelete: SetNull)
  followedUpBy       Activity[] @relation("ActivityFollowUp")

  // --- Custom fields ---

  customFields Json? @map("custom_fields") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status]) // Compound: "all open activities for tenant"
  @@index([tenantId, assignedUserId]) // Compound: "my activities" — most common dashboard query
  @@index([tenantId, scheduledStart]) // Compound: calendar/timeline queries per tenant
  @@index([type])
  @@index([priority])
  @@index([companyId])
  @@index([customerId])
  @@index([opportunityId])
  @@index([leadId])
  @@index([scheduledStart, scheduledEnd]) // Compound: range queries (e.g. activities this week)
  @@index([followUpActivityId]) // Self-relation lookup: "follow-ups of activity X"
  @@index([attachments], where: { attachments: { not: null } }, map: "activities_has_attachments ")
  @@map("activities")
}

/// Junction table linking activities to their participants.
/// A participant can be an internal User, an existing Contact, or an external attendee (email only).
model ActivityParticipant {
  id String @id @default(cuid())

  activityId String   @map("activity_id")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  // Exactly one of userId / contactId / externalEmail must be populated.
  // Enforce this constraint at the application layer (Zod / service).

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contactId String?  @map("contact_id")
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Email for external attendees not in the system.
  externalEmail String? @map("external_email") @db.VarChar(255)
  externalName  String? @map("external_name") @db.VarChar(255)

  status ParticipantStatus @default(INVITED)
  role   ParticipantRole   @default(OPTIONAL)

  responseDate DateTime? @map("response_date")
  notes        String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Prevent duplicate participant rows for the same user/contact on the same activity.
  @@unique([activityId, userId])
  @@unique([activityId, contactId])
  @@unique([activityId, externalEmail], where: { externalEmail: { not: null } }, map: "activity_participants_unique_external_email")
  @@index([activityId])
  @@index([userId])
  @@index([contactId])
  @@map("activity_participants")
}

/// Reusable activity templates for activity creation.
/// tenantId = NULL  → global system template, visible to all tenants.
/// tenantId = set   → private template visible only to that tenant.
/// Application layer must always filter: WHERE tenant_id = ? OR tenant_id IS NULL.
model ActivityTemplate {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(255)
  description String? @db.Text

  type     ActivityType
  priority ActivityPriority @default(MEDIUM)

  /// Default duration in minutes when using this template.
  defaultDuration    Int?    @map("default_duration")
  defaultSubject     String  @map("default_subject") @db.VarChar(255)
  defaultDescription String? @map("default_description") @db.Text

  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("TenantActivityTemplates", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Optional step-by-step checklist: [{ order, label, required }].
  checklist Json? @db.JsonB

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Template names must be unique per tenant.
  // Global templates (tenantId IS NULL) are deduplicated by name at the application layer.
  @@unique([tenantId, name])
  @@unique([name], where: { tenantId: null}, map: "activity_templates_global_name")
  @@index([tenantId])
  @@index([type])
  @@index([active])
  @@map("activity_templates")
}
