model User {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(50)
  email    String  @unique @db.VarChar(255)
  password String  @db.VarChar(255) // bcrypt hash
  active   Boolean @default(true)

  // === EMAIL VERIFICATION ===
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique @db.Char(64) // SHA-256 hash
  emailVerificationExpires DateTime?
  emailVerifiedAt          DateTime? // timestamp verifica

  // === PASSWORD RESET ===
  resetPasswordToken    String?   @unique @db.Char(64) // Char(64) per SHA-256
  resetPasswordExpires  DateTime?
  passwordResetAttempts Int       @default(0) // rate limiting
  lastPasswordResetAt   DateTime? // audit trail

  // === TWO-FACTOR AUTHENTICATION (2FA) ===
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String? @db.VarChar(255) // TOTP secret
  twoFactorBackupCodes Json? // backup codes array

  // === SECURITY & AUDIT ===
  lastPasswordChangeAt DateTime? // traccia ultimo cambio password
  passwordChangedBy    Int? // admin che ha cambiato password

  failedLoginAttempts Int       @default(0) // rate limiting login
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime? // account temporaneamente bloccato

  // === GDPR & PRIVACY ===
  consentGivenAt         DateTime? // consenso privacy
  dataRetentionExpiresAt DateTime? // scadenza dati GDPR

  roles Role[] @relation("UserRoles")
  settings UserSetting[] @relation("UserSettings")

  // Preferenze lingua
  preferredLanguageId Int      @default(1)
  preferredLanguage   Language @relation("UserPreferredLanguage", fields: [preferredLanguageId], references: [id])

  // Relazioni (le tue esistenti)
  createdDocuments      Document[]            @relation("CreatedBy")
  assignedDocuments     Document[]            @relation("AssignedTo")
  createdOpportunities  Opportunity[]         @relation("CreatedBy")
  assignedOpportunities Opportunity[]         @relation("AssignedTo")
  assignedCompanies     Company[]             @relation("AssignedUser")
  activitiesAssigned    Activity[]            @relation("ActivityAssigned")
  activitiesCreated     Activity[]            @relation("ActivityCreated")
  activityParticipants  ActivityParticipant[]
  companyNotes          CompanyNote[]
  stockMovement         StockMovement[]
  auditLogs             AuditLog[]
  SecurityEvents        SecurityEvent[]

  deletedDocuments       Document[]       @relation("DeletedBy")
  deletedProducts        Product[]        @relation("DeletedBy")
  deletedProductVariants ProductVariant[] @relation("DeletedBy")
  deletedCustomers       Customer[]       @relation("DeletedBy")
  deletedSuppliers       Supplier[]       @relation("DeletedBy")

  assignedLeads  Lead[] @relation("LeadAssignedUser")
  convertedLeads Lead[] @relation("LeadConvertedBy")
  createdLeads   Lead[] @relation("LeadCreatedBy")

  details UserDetails?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([emailVerificationToken])
  @@index([resetPasswordToken])
  @@index([lockedUntil]) // per query account bloccati
}

model UserDetails {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String @db.VarChar(100)
  lastName  String? @db.VarChar(100)

  profilePicture String? @db.VarChar(500)

  // Contatti e Indirizzo
  phone   String? @db.VarChar(20)
  address String? @db.VarChar(255)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  zipCode String? @db.VarChar(20)
  country String? @default("IT") @db.Char(2)

  // Dati personali
  dateOfBirth DateTime? @db.Date
  gender      Gender    @default(PREFER_NOT_TO_SAY)
  bio         String?   @db.Text

  lastLogin DateTime?
  active    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstName])
  @@index([lastName])
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}
