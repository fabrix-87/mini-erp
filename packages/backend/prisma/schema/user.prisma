// ============================================================================
// IDENTITY AND AUTHENTICATION
// Core user accounts supporting RBAC, multi-tenancy, and advanced security workflows.
// ============================================================================

/// Global user identity — not directly tenant-scoped.
/// Tenant membership and per-tenant roles are managed via UserTenantMembership.
/// A user with no memberships is a system-level or unassigned account.
model User {
  id       String @id @default(cuid())
  username String @unique @db.VarChar(50)
  email    String @unique @db.VarChar(255)

  /// Storage for salted password cryptographic hashes (e.g., Argon2id or bcrypt).
  password String  @db.VarChar(255)
  active   Boolean @default(true)

  // === EMAIL VERIFICATION ===
  emailVerified Boolean @default(false) @map("email_verified")

  /// Cryptographic token used during signup or email-change confirmation sequences.
  emailVerificationToken   String?   @unique @map("email_verification_token") @db.Char(64)
  emailVerificationExpires DateTime? @map("email_verification_expires")
  emailVerifiedAt          DateTime? @map("email_verified_at")

  // === PASSWORD RESET ===

  /// Cryptographic token used during self-service recovery workflows.
  resetPasswordToken   String?   @unique @map("reset_password_token") @db.Char(64)
  resetPasswordExpires DateTime? @map("reset_password_expires")

  /// Counter for mitigation against token enumeration and brute-force vectors.
  passwordResetAttempts Int       @default(0) @map("password_reset_attempts")
  lastPasswordResetAt   DateTime? @map("last_password_reset_at")

  // === TWO-FACTOR AUTHENTICATION (2FA) ===
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  /// TOTP seed (RFC 6238). Must be AES-256-GCM encrypted at the application layer before persistence.
  /// Never store the raw Base32 secret in plaintext.
  twoFactorSecret String? @map("two_factor_secret") @db.VarChar(255)

  /// Encrypted payload containing deterministic fallback codes.
  twoFactorBackupCodes Json? @map("two_factor_backup_codes")

  // === SECURITY & AUDIT ===
  lastPasswordChangeAt DateTime? @map("last_password_change_at")

  // On the target user (whose password was overridden)
  passwordChangedById String? @map("password_changed_by_id")
  passwordChangedBy   User?   @relation("AdminPasswordOverride", fields: [passwordChangedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Counter for mitigation against brute-force login vectors.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lastFailedLoginAt   DateTime? @map("last_failed_login_at")

  /// Operational timestamp restriction window enforced during rate-limiting lockout phases.
  lockedUntil DateTime? @map("locked_until")

  // === GDPR & PRIVACY ===

  /// Immutable record documenting active acknowledgment of legal policies.
  consentGivenAt DateTime? @map("consent_given_at")

  /// Automated archival/deletion threshold mapping for standard right-to-be-forgotten timelines.
  dataRetentionExpiresAt DateTime? @map("data_retention_expires_at")

  settings UserSetting[] @relation("UserSettings")

  preferredLanguageId Int?      @map("preferred_language_id")
  preferredLanguage   Language? @relation("UserPreferredLanguage", fields: [preferredLanguageId], references: [id])

  /// All tenant memberships for this user. A user may belong to multiple tenants.
  memberships             UserTenantMembership[]     @relation("UserTenants")
  // Core System Operational Relations
  createdDocuments        Document[]                 @relation("CreatedBy")
  assignedDocuments       Document[]                 @relation("AssignedTo")
  createdOpportunities    Opportunity[]              @relation("CreatedBy")
  assignedOpportunities   Opportunity[]              @relation("AssignedTo")
  assignedCompanies       Company[]                  @relation("AssignedUser")
  activitiesAssigned      Activity[]                 @relation("ActivityAssigned")
  activitiesCreated       Activity[]                 @relation("ActivityCreated")
  paymentBatches          PaymentBatch[]             @relation("PaymentBatchCreatedBy")
  approvedPaymentBatches  PaymentBatch[]             @relation("PaymentBatchApprovedBy")
  activityParticipants    ActivityParticipant[]
  companyNotes            CompanyNote[]
  stockMovement           StockMovement[]
  auditLogs               AuditLog[]
  securityEvents          SecurityEvent[]
  resolvedSecurityEvents  SecurityEvent[]            @relation("ResolvedSecurityEvents")
  documentStatusHistories DocumentStatusHistory[]
  lockedAccountingPeriods AccountingPeriod[]         @relation("PeriodLockedBy")
  closedFiscalYears       FiscalYear[]               @relation("FiscalYearClosedBy")
  createdJournalEntries   JournalEntry[]             @relation("JournalEntryCreatedBy")
  postedJournalEntries    JournalEntry[]             @relation("JournalEntryPostedBy")
  verifiedBankDetails     Document[]                 @relation("DocumentBankDetailsVerifiedBy")
  submittedSettlements    WithholdingTaxSettlement[] @relation("SettlementSubmittedBy")
  // On the admin user (back-relation — who performed the override)
  overriddenPasswordUsers User[]                     @relation("AdminPasswordOverride")

  // Soft-Delete / Auditing Attribution Targets
  deletedDocuments       Document[]       @relation("DeletedBy")
  deletedProducts        Product[]        @relation("ProductDeletedBy")
  deletedContacts        Contact[]        @relation("ContactDeletedBy")
  deletedProductVariants ProductVariant[] @relation("ProductVariantDeletedBy")
  deletedCustomers       Customer[]       @relation("DeletedBy")
  deletedSuppliers       Supplier[]       @relation("DeletedBy")
  deletedUsers           User[]           @relation("DeletedBy")

  // Sales CRM Subsystem Assignments
  assignedLeads  Lead[] @relation("LeadAssignedUser")
  convertedLeads Lead[] @relation("LeadConvertedBy")
  createdLeads   Lead[] @relation("LeadCreatedBy")

  details       UserDetails?
  deletedBy     String?      @map("deleted_by")
  deletedByUser User?        @relation("DeletedBy", fields: [deletedBy], references: [id])

  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft-delete timestamp. NULL = active record. Set by the delete service; never updated directly.
  deletedAt DateTime? @map("deleted_at")

  @@index([lockedUntil])
  @@map("users")
}

// ============================================================================
// USER PROFILE DATA
// Vertical partition separating structural identity data from application-level details.
// ============================================================================

/// Volatile profile attributes and contextual interaction data for individual entities.
model UserDetails {
  id Int @id @default(autoincrement())

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)

  profilePicture String? @map("profile_picture") @db.Text

  phone   String? @db.VarChar(20)
  address String? @db.VarChar(255)
  city    String? @db.VarChar(100)
  state   String? @db.VarChar(100)
  zipCode String? @map("zip_code") @db.VarChar(20)

  /// ISO 3166-1 alpha-2 geographical country reference code.
  countryCode String?  @default("IT") @map("country_code") @db.Char(2)
  country     Country? @relation("UserDetailCountry", fields: [countryCode], references: [code])

  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      Gender    @default(PREFER_NOT_TO_SAY)
  bio         String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([firstName, lastName])
  @@map("user_details")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Junction between a User and a Tenant.
/// Carries the membership lifecycle (INVITED → ACTIVE → SUSPENDED)
/// and is the aggregate root for per-tenant role assignments.
model UserTenantMembership {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  tenantId String @map("tenant_id")

  /// Lifecycle state of the membership.
  /// INVITED: user has been invited but has not yet accepted.
  /// ACTIVE: user has full access according to assigned roles.
  /// SUSPENDED: access revoked without deleting the membership record.
  status MembershipStatus @default(ACTIVE)

  user   User   @relation("UserTenants", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Marks the tenant loaded by default on login when the user belongs to multiple tenants.
  /// At most one membership per user may be true.
  /// Enforced at the application layer: unset all others within a transaction before setting a new default.
  isDefault Boolean @default(false) @map("is_default")

  roles UserTenantMembershipRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tenantId])
  @@unique([userId], where: { isDefault: true }, map: "unique_default_user_tenant")
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenant_memberships")
}

/// Assigns a Role to a User within a specific tenant membership.
/// A user may hold multiple roles per tenant.
/// Roles are always scoped to the membership — never global.
model UserTenantMembershipRole {
  membershipId String @map("membership_id")
  roleId       Int    @map("role_id")

  membership UserTenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                 @relation("UserTenantRoles", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("user_tenant_membership_roles")
}

/// Lifecycle states for a user's membership in a tenant.
enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}
