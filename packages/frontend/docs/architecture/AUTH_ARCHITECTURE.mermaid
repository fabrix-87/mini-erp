graph TB
    subgraph "Client (Next.js)"
        A[Browser] --> B[AuthProvider]
        B --> C[Token Refresh Timer]
        B --> D[API Client]
        D --> E[Interceptor]
    end
    
    subgraph "Middleware Layer"
        F[proxy.ts]
        F --> G{Route Protection}
        G --> H[Public Routes]
        G --> I[Protected Routes]
        G --> J[Admin Routes]
    end
    
    subgraph "Server (Next.js)"
        K[Server Actions]
        K --> L[serverApi]
        L --> M[Cookie Manager]
    end
    
    subgraph "Backend (Express)"
        N[Auth Controller]
        N --> O[JWT Service]
        N --> P[Fingerprint Service]
        N --> Q[Session Manager]
    end
    
    subgraph "Storage"
        R[(PostgreSQL)]
        S[(Redis)]
    end
    
    A --> F
    E --> K
    K --> N
    N --> R
    N --> S
    Q --> S
