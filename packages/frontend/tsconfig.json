{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "next-intl/plugin"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@mini-erp/shared": ["../shared/src/index.ts"],
      "@mini-erp/shared/validators": ["../shared/src/validators/index.ts"],
      "@mini-erp/shared/validators/*": ["../shared/src/validators/*.ts"],
      "@mini-erp/shared/types": ["../shared/src/types/index.ts"],
      "@mini-erp/shared/constants": ["../shared/src/constants/index.ts"],
      "@mini-erp/shared/utils": ["../shared/src/utils/index.ts"],
      "react-hook-form": ["../node_modules/react-hook-form"],
      "@hookform/resolvers": ["../node_modules/@hookform/resolvers"],
      "@hookform/resolvers/*": ["../node_modules/@hookform/resolvers/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
