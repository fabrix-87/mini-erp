# ============================================================================
# Frontend Environment Variables (.env.local)
# Copy this file to .env.local and fill in the values
# ============================================================================

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------

# Public API URL (used by client-side code)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Internal API URL (used by server-side code like middleware and server components)
# This can be different from NEXT_PUBLIC_API_URL for internal network routing
API_URL=http://localhost:5000

# ----------------------------------------------------------------------------
# JWT Configuration
# IMPORTANT: These must match the backend .env values
# ----------------------------------------------------------------------------

# JWT Secret Key (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# JWT Issuer (identifies who created the token)
JWT_ISSUER=your-app-backend

# JWT Audience (identifies who should receive the token)
JWT_AUDIENCE=your-app-frontend

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------

# Environment (development, staging, production)
NODE_ENV=development

# Next.js specific
NEXT_PUBLIC_APP_NAME="Enterprise ERP"
NEXT_PUBLIC_APP_VERSION=1.0.0
COMPANY_NAME="Company ltd"
APP_NAME="MyERP - Gestionale Aziendale"

# ----------------------------------------------------------------------------
# Feature Flags (optional)
# ----------------------------------------------------------------------------

# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# Enable fingerprinting (should match backend)
NEXT_PUBLIC_FINGERPRINT_ENABLED=true

# ----------------------------------------------------------------------------
# Analytics & Monitoring (optional)
# ----------------------------------------------------------------------------

# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Google Analytics ID
NEXT_PUBLIC_GA_ID=

# ----------------------------------------------------------------------------
# Development Tools (optional)
# ----------------------------------------------------------------------------

# React DevTools
REACT_EDITOR=vscode

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1